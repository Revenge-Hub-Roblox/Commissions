    if now - zouCache.t > ZOU_CACHE_TTL then
        pcall(function()
            zouCache.progress = xuynia_RF:InvokeServer("BartiloQuestProgress", "Bartilo") or -1
        end)
        zouCache.t = now
    end
    return zouCache.progress
end

