    if d > (vars.SettleRange or 15) then
        core.gotoQuest(targetCF)
    else
        humanoidRootPart.CFrame = targetCF
        if idk then idk.CFrame = targetCF end
        if vars.BodyClip then vars.BodyClip.Velocity = Vector3.zero end
    end
    return true
end

