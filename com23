function core.getQuestTargets(taskTable)
    local list = {}
    if type(taskTable) ~= "table" then return list end
    for mobName, req in pairs(taskTable) do
        if type(mobName) == "string" then
            local need = type(req) == "number" and req or (type(req) == "table" and req.Amount) or 1
            if need > 0 then table.insert(list, { Name = mobName, Need = need }) end
        end
    end
    return list
end

function core.getBestQuest()
    local currentLevel = core.getLevel()
    local minL = Config.LevelRange and (Config.MinLevel or 1) or 1
    local maxL = Config.LevelRange and (Config.MaxLevel or 2800) or 99999
    local best = nil
    for quest_Name, quest_Data in next, questsM do
        if type(quest_Data) == "table" and not quest_blacklist[quest_Name] then
            for id, entry in next, quest_Data do
                if type(entry) == "table"
                    and type(entry.LevelReq) == "number"
                    and type(entry.Task) == "table"
                    and currentLevel >= entry.LevelReq
                    and entry.LevelReq >= minL
                    and entry.LevelReq <= maxL
                then
                    local targets = core.getQuestTargets(entry.Task)
                    if #targets > 0 then
                        if not best or entry.LevelReq > best.LevelReq then
                            best = {
                                InternalName = quest_Name,
                                ID = id,
                                LevelReq = entry.LevelReq,
                                DisplayName = entry.Name or quest_Name,
                                Task = entry.Task,
                                Targets = targets,
                                PrimaryMob = targets[1].Name,
                            }
                        end
                    end
                end
            end
        end
    end
    return best
end

function core.getQuestProgress()
    local q = ActiveQuest or (guideM.Data and guideM.Data.QuestData)
    if not q or type(q) ~= "table" or type(q.Info) ~= "table" then return nil end
    local taskT = q.Info.Task or {}
    local prog = q.Progress or {}
    local targets = {}
    local done, total = 0, 0
    for mobName, req in pairs(taskT) do
        if type(mobName) == "string" then
            local need = type(req) == "number" and req or (type(req) == "table" and req.Amount) or 1
            local cur = prog[mobName]
            local have = 0
            if cur == true then have = need
            elseif type(cur) == "number" then have = math.clamp(cur, 0, need) end
            done += have
            total += need
            table.insert(targets, { Name = mobName, Have = have, Need = need, Done = have >= need })
        end
    end
    return {
        InternalName = q.InternalQuestName,
        DisplayName = q.Info.Name or q.InternalQuestName,
        Task = taskT,
        Progress = prog,
        Targets = targets,
        PrimaryMob = targets[1] and targets[1].Name,
        Current = done,
        Max = total,
        Finished = total > 0 and done >= total,
        Raw = q,
    }
end

