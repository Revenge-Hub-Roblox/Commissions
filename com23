local function FindGroundFruit()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Tool") then
            local name = obj.Name
            local matched = nil
            for _, allowed in ipairs(CONFIG.AllowedSea3Fruits) do
                local display = allowed:split("-")[1]
                if name == (display .. " Fruit") or name:find(display, 1, true) then
                    matched = allowed
                    break
                end
            end
            if matched then
                local handle = obj:IsA("Tool") and obj:FindFirstChild("Handle")
                    or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    return obj, handle
                end
            end
        end
    end
    return nil, nil
end

