function core.useFruitSkills(mob)
    if Config.FarmMethod ~= "Fruit" then return end
    if tick() < (vars._FruitSkillsReady or 0) then return end
    local fruit = core.getFruitEquipped()
    if fruit and fruit.Parent ~= character and humanoid then
        pcall(function() humanoid:EquipTool(fruit) end)
        task.wait(0.15)
    end
    local root = mob and mob:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if cam and root then
        pcall(function()
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, root.Position)
        end)
        task.wait(0.04)
    end
    local any = false
    for _, key in ipairs({ "Z", "X", "C", "V", "F" }) do
        if Config.FruitSkills[key] then
            any = true
            if mob and not core.IsAlive(mob) then break end
            core.pressSkill(key)
            task.wait(vars.SkillDelay or 0.25)
        end
    end
    if any then vars._FruitSkillsReady = tick() + 0.6 end
end

