local function AtEntrance()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if InUnderwater() then return true end
    return (root.Position - UW_ENTER).Magnitude <= UW_ARRIVE_RADIUS
end

local function EnterUnderwaterCity()
    if InUnderwater() then return true end
    if not _G.Level then return false end
    if UWRouteBusy then return false end

    UWRouteBusy = true
    local ok = false

    local targetCF = CFrame.new(UW_ENTER + Vector3.new(0, 4, 0))
    UpdateStatus("Fishman: flying to cavern entrance")
    _tp(targetCF)

    local lastFire = 0
    local deadline = tick() + UW_MAX_TIME
    while tick() < deadline do
        if not _G.Level then break end

        if InUnderwater() then
            ok = true
            UpdateStatus("Fishman: inside underwater city")
            break
        end

        if AtEntrance() and tick() - lastFire >= UW_REMOTE_EVERY then
            lastFire = tick()
            ReqEnter(UW_ENTER)
        end

        if activeTarget and (activeTarget.Position - targetCF.Position).Magnitude > 30 then
            _tp(targetCF, true)
        end

        task.wait(0.2)
    end

    if not ok then
        UpdateStatus("Fishman: last resort TP into city")
        notween(CFrame.new(UW_QUESTSPOT))
        task.wait(0.4)
        ok = InUnderwater()
    end

    UWRouteBusy = false
    return ok
end

local function ExitUnderwaterCity()
    if not InUnderwater() then return true end
    if not _G.Level then return false end
    if UWRouteBusy then return false end

    UWRouteBusy = true
    local ok = false

    local exitPos = UW_CITY_EXIT
    pcall(function()
        local ex = workspace:FindFirstChild("TeleportSpawn", true)
            or (workspace.Map and workspace.Map:FindFirstChild("Exit", true))
        if ex and ex:IsA("BasePart") then
            exitPos = ex.Position
        end
    end)

    local targetCF = CFrame.new(exitPos + Vector3.new(0, 4, 0))
    UpdateStatus("Fishman: exiting city")
    _tp(targetCF)

    local lastFire = 0
    local deadline = tick() + UW_MAX_TIME
    while tick() < deadline do
        if not _G.Level then break end

        if not InUnderwater() then
            ok = true
            UpdateStatus("Fishman: exited, normal route")
            break
        end

        if tick() - lastFire >= UW_REMOTE_EVERY then
            lastFire = tick()
            ReqEnter(exitPos)
        end

        if activeTarget and (activeTarget.Position - targetCF.Position).Magnitude > 30 then
            _tp(targetCF, true)
        end

        task.wait(0.2)
    end

    if not ok then
        UpdateStatus("Fishman: last resort TP outside")
        notween(CFrame.new(UW_OUT))
        task.wait(0.4)
        ok = not InUnderwater()
    end

    UWRouteBusy = false
    return ok
end

