function core.attack(mob)
    if not core.IsAlive(mob) or not character then return false end
    local now = tick()
    if now - LastFire < vars.FireInterval then return false end
    LastFire = now
    local method = Config.FarmMethod or "Melee"
    if method == "Gun" then
        return core.attackGun(mob)
    elseif method == "Fruit" then
        return core.attackFruit(mob)
    else
        return core.attackMeleeOrSword(mob)
    end
end

