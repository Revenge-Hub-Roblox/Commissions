function core.SpawnTweenPart()
    if not character or not humanoidRootPart then return false end
    if not idk or not idk.Parent then
        local part = Instance.new("Part")
        part.Name = "RH_FarmBlock"
        part.Size = Vector3.new(2, 1, 2)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.Parent = workspace
        idk = part
    end
    if not vars.BodyClip or not vars.BodyClip.Parent then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "RH_BodyClip"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = humanoidRootPart
        vars.BodyClip = bv
    elseif vars.BodyClip.Parent ~= humanoidRootPart then
        vars.BodyClip.Parent = humanoidRootPart
    end
    return true
end

function core.gotoQuest(pos, force)
    if not character or not humanoidRootPart then
        core.log("gotoQuest error, no char/hrp", true)
        return
    end
    core.SpawnTweenPart()
    local goal
    if typeof(pos) == "Vector3" then
        goal = CFrame.new(pos)
    elseif typeof(pos) == "CFrame" then
        goal = pos
    else
        return
    end
    if not force and activeTween
        and activeTween.PlaybackState == Enum.PlaybackState.Playing
        and activeTarget and (activeTarget.Position - goal.Position).Magnitude < 2 then
        return
    end
    if activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing then
        pcall(function() activeTween:Cancel() end)
    end
    if idk then
        idk.CFrame = humanoidRootPart.CFrame
    end
    local dist = (goal.Position - (idk and idk.Position or humanoidRootPart.Position)).Magnitude
    local time = math.max(dist / (vars.QuestMoveSpeed or QUEST_MOVE_SPEED), 0.05)
    activeTarget = goal
    local tw = tween_Service:Create(idk, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = goal })
    activeTween = tw
    vars.Tweening = true
    tw:Play()
    task.spawn(function()
        while tw and tw.PlaybackState == Enum.PlaybackState.Playing do
            if not shouldTween or not vars.FarmEnabled then
                pcall(function() tw:Cancel() end)
                break
            end
            if humanoidRootPart and idk then
                local d = (humanoidRootPart.Position - idk.Position).Magnitude
                if d <= 25 then
                    humanoidRootPart.CFrame = idk.CFrame
                end
            end
            task.wait()
        end
        vars.Tweening = false
        if humanoidRootPart and idk then
            humanoidRootPart.CFrame = idk.CFrame
        end
    end)
end

function core.gotoFruit(pos)
    if vars.Tweening then return end
    if not character or not humanoidRootPart then return end
    core.SpawnTweenPart()
    local goal
    if typeof(pos) == "Vector3" then
        goal = CFrame.new(pos)
    elseif typeof(pos) == "CFrame" then
        goal = pos
    else
        return
    end
    local start = humanoidRootPart.Position
    local target = goal.Position
    local dist = (target - start).Magnitude
    if dist < 1 then
        humanoidRootPart.CFrame = goal
        if idk then idk.CFrame = goal end
        return
    end
    local duration = math.clamp(dist / vars.TweenSpeed, 0.05, 12)
    vars.Tweening = true
    local t0 = tick()
    while tick() - t0 < duration do
        if not character or not humanoidRootPart then break end
        local alpha = math.clamp((tick() - t0) / duration, 0, 1)
        local p = start:Lerp(target, alpha)
        local cf = CFrame.new(p)
        humanoidRootPart.CFrame = cf
        if idk then idk.CFrame = cf end
        if vars.BodyClip then vars.BodyClip.Velocity = Vector3.zero end
        run_Service.Heartbeat:Wait()
    end
    if character and humanoidRootPart then
        humanoidRootPart.CFrame = goal
        if idk then idk.CFrame = goal end
    end
    vars.Tweening = false
end

