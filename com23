function core.IsAlive(mob)
    if typeof(mob) ~= "Instance" then return false end
    local h = mob:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

function core.getBestWeapon(method)
    local list = weapon_lists[method]
    if not list then return vars.SelectWeapon end
    for _, bag in ipairs({ character, backpack }) do
        if bag then
            for _, name in ipairs(list) do
                local t = bag:FindFirstChild(name)
                if t and t:IsA("Tool") then return name end
            end
        end
    end
    return vars.SelectWeapon
end

function core.equipWeapon(weaponName)
    if not character or not humanoid then return false end
    local name = weaponName
    if typeof(weaponName) == "Instance" then
        name = weaponName.Name
    elseif typeof(weaponName) ~= "string" or weaponName == "" then
        return false
    end
    if character:FindFirstChild(name) and character[name]:IsA("Tool") then return true end
    local tool = backpack and backpack:FindFirstChild(name)
    if not tool or not tool:IsA("Tool") then return false end
    pcall(function() humanoid:EquipTool(tool) end)
    if not character:FindFirstChild(name) then tool.Parent = character end
    return character:FindFirstChild(name) ~= nil
end

