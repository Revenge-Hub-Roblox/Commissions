local function GetBestQuest()
    local lvl = GetPlayerLevel() or 0

    if lvl >= 700 and World1 then
        return { Mob = "Galley Captain", NameQuest = "FountainQuest", ID = 2, LevelReq = 700 }
    end
    if lvl >= 1500 and World2 then
        return { Mob = "Water Fighter", NameQuest = "ForgottenQuest", ID = 2, LevelReq = 1450 }
    end

    if QuestModule and type(QuestModule) == "table" then
        local best = { LevelReq = -1 }
        for qName, qData in pairs(QuestModule) do
            if type(qData) == "table" and not table.find(blacklist, qName) then
                for id, d in pairs(qData) do
                    if type(d) == "table" and type(d.LevelReq) == "number" and type(d.Task) == "table" then
                        for mob, count in pairs(d.Task) do
                            if type(mob) == "string" and type(count) == "number"
                                and count > 1 and lvl >= d.LevelReq then
                                local better = d.LevelReq > best.LevelReq
                                    or (d.LevelReq == best.LevelReq and tostring(qName) < tostring(best.NameQuest))
                                if better then
                                    best = { Mob = mob, NameQuest = qName, ID = id, LevelReq = d.LevelReq, Count = count }
                                end
                            end
                        end
                    end
                end
            end
        end
        if best.Mob then return best end
    end

    local best
    for _, q in ipairs(QUEST_GIVERS) do
        if lvl >= (q.Level or 0) and (not best or (q.Level or 0) > (best.Level or 0)) then
            best = q
        end
    end
    return best
end

