local function GetQuestMob(quest)
    local text = Norm((quest.Name or "") .. " " .. (quest.Target or ""))
    if text == "" then return nil end

    local c = QuestMobCache[text]
    if c then
        if c.mob and (ModulePoolLoaded or tick() - c.t < 6) then
            return c.mob
        end
        if not c.mob and tick() - c.t < 1.5 then
            return nil
        end
    end

    local best, bestLen = nil, 0
    for name in pairs(AllMobNames) do
        if TextHas(text, name) and #name > bestLen then
            best, bestLen = name, #name
        end
    end
    QuestMobCache[text] = { mob = best, t = tick() }
    return best
end

