end

function core.getClosestMob(name)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies or not humanoidRootPart then return nil end
    local best, bestD = nil, math.huge
    for _, v in ipairs(enemies:GetChildren()) do
        if v:IsA("Model") and core.IsAlive(v) then
            if not name or v.Name == name then
                local hrp = v:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - humanoidRootPart.Position).Magnitude
                    if d < bestD then bestD, best = d, v end
                end
            end
        end
    end
    return best
end

function core.getMobSpawnCFrame(mobName)
    if type(mobName) ~= "string" or mobName == "" then return nil end
    local short = string.gsub(mobName, "%s*%[Lv%.?%s*%d+%]$", "")
    local world = workspace:FindFirstChild("_WorldOrigin")
    local spawns = world and world:FindFirstChild("EnemySpawns")
    if spawns then
        local best
        for _, sp in ipairs(spawns:GetChildren()) do
            local n = sp.Name
            if n == mobName or n == short or string.find(n, short, 1, true) then
                if sp:IsA("BasePart") then
                    return sp.CFrame
                elseif sp:IsA("Model") then
                    local p = sp.PrimaryPart or sp:FindFirstChildWhichIsA("BasePart")
                    if p then return p.CFrame end
                elseif typeof(sp.CFrame) == "CFrame" then
                    return sp.CFrame
                elseif typeof(sp.Position) == "Vector3" then
                    return CFrame.new(sp.Position)
                end
            end
        end
    end
    if world then
        for _, sp in ipairs(world:GetDescendants()) do
            if sp:IsA("BasePart") then
                local n = sp.Name
