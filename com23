_tp = function(cf, force)
    if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
    if typeof(cf) ~= "CFrame" then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if not force and activeTween
        and activeTween.PlaybackState == Enum.PlaybackState.Playing
        and activeTarget and (activeTarget.Position - cf.Position).Magnitude < 2 then
        return
    end

    if activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing then
        activeTween:Cancel()
    end

    block.CFrame = root.CFrame

    local dist = (cf.Position - block.Position).Magnitude
    local time = math.max(dist / MOVE_SPEED, 0.05)

    activeTarget = cf
    local tw = TweenService:Create(block, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = cf })
    activeTween = tw
    tw:Play()
    task.spawn(function()
        while tw and tw.PlaybackState == Enum.PlaybackState.Playing do
            if not shouldTween then tw:Cancel() break end
            task.wait()
        end
    end)
end

