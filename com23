function core.EnterUnderwaterCity()
    if core.InUnderwater() then return true end
    if UWRouteBusy then return false end
    UWRouteBusy = true
    local ok = false
    local targetCF = CFrame.new(UW_ENTER + Vector3.new(0, 4, 0))
    core.log("Fishman: flying to cavern entrance")
    core.gotoQuest(targetCF, true)
    local lastFire = 0
    local deadline = tick() + UW_MAX_TIME
    while tick() < deadline do
        if not vars.FarmEnabled then break end
        if core.InUnderwater() then
            ok = true
            core.log("Fishman: inside underwater city")
            break
        end
        if humanoidRootPart and (humanoidRootPart.Position - UW_ENTER).Magnitude <= UW_ARRIVE_RADIUS then
            if tick() - lastFire >= UW_REMOTE_EVERY then
                lastFire = tick()
                core.ReqEnter(UW_ENTER)
            end
        end
        task.wait(0.2)
    end
    if not ok then
        core.log("Fishman: last resort TP into city")
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(UW_QUESTSPOT)
        end
        task.wait(0.4)
        ok = core.InUnderwater()
    end
    UWRouteBusy = false
    return ok
end

function core.ExitUnderwaterCity()
    if not core.InUnderwater() then return true end
    if UWRouteBusy then return false end
    UWRouteBusy = true
    local ok = false
    local exitPos = UW_CITY_EXIT
    local targetCF = CFrame.new(exitPos + Vector3.new(0, 4, 0))
    core.log("Fishman: exiting city")
    core.gotoQuest(targetCF, true)
    local lastFire = 0
    local deadline = tick() + UW_MAX_TIME
    while tick() < deadline do
        if not vars.FarmEnabled then break end
        if not core.InUnderwater() then
            ok = true
            core.log("Fishman: exited")
            break
        end
        if tick() - lastFire >= UW_REMOTE_EVERY then
            lastFire = tick()
            core.ReqEnter(exitPos)
        end
        task.wait(0.2)
    end
    if not ok then
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(UW_OUT)
        end
        task.wait(0.4)
        ok = not core.InUnderwater()
    end
    UWRouteBusy = false
    return ok
end

