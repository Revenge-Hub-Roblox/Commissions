local function ResetQuestState()
    QuestState.Confirmed = false
    QuestState.Mob, QuestState.Need = nil, nil
    QuestState.DeepFish = nil
    QuestState.TakenAt = 0
    QuestKillCount = 0
    CompleteStallSince = nil
end

local function QuestFarmStep()
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if Sea2Mode or TravelActive or ZouActive then return end

    local now = tick()
    local quest = GetCurrentQuest()

    if quest then
        QuestState.LastSeen = now
        QuestState.Confirmed = true

        local a, b = ParseProgress(quest.Progress)
        if a and b and b > 0 and a >= b then
            CompleteStallSince = CompleteStallSince or now
            if now - CompleteStallSince >= COMPLETE_STALL then
                UpdateStatus("Quest done, tracker not cleared, taking next")
                pcall(function() CommF:InvokeServer("AbandonQuest") end)
                ResetQuestState()
                QuestState.LastTry = 0
            end
            return
        end
        CompleteStallSince = nil

        local parsed = GetQuestMob(quest)

        if not QuestState.Mob and parsed then
            QuestState.Mob = parsed
            if QuestState.DeepFish == nil and parsed then
                QuestState.DeepFish = World1 and TextHas(parsed, "Fishman") or false
            end
        end

        if ModulePoolLoaded and QuestState.Mob and parsed and not SameMob(parsed, QuestState.Mob) then
            UpdateStatus("Wrong quest (" .. parsed .. " != " .. QuestState.Mob .. "), abandoning")
            pcall(function() CommF:InvokeServer("AbandonQuest") end)
            ResetQuestState()
            QuestState.LastTry = 0
            return
        end

        local mob = QuestState.Mob or parsed
        if mob then
            QuestState.Mob = mob
            HookMobs(mob)
            UpdateStatus(("Farm %s | mob: %s | %s"):format(quest.Name, mob, quest.Progress ~= "" and quest.Progress or "..."))
            FarmQuestMob(mob)
        else
            UpdateStatus("Detecting quest mob: " .. quest.Name)
            RebuildMobPool()
        end
        return
    end

    local sinceSeen = now - QuestState.LastSeen

    if QuestState.Confirmed then
        if sinceSeen < GUI_LAG then
            if QuestState.Mob and not UWRouteBusy then FarmQuestMob(QuestState.Mob) end
            return
        end
        ResetQuestState()
        UpdateStatus("Quest done, looking for next")
        return
    end

    if QuestState.Need and QuestKillCount >= QuestState.Need then
        ResetQuestState()
        UpdateStatus("Quest done by kill counter")
        return
    end

    if now - QuestState.TakenAt < QUEST_GRACE then
        if QuestState.Mob and not UWRouteBusy then FarmQuestMob(QuestState.Mob) end
        return
    end

    if now - QuestState.LastTry < 2 then return end
    QuestState.LastTry = now

    local best = GetBestQuest()
    if not best then
        UpdateStatus("No suitable quest for level " .. tostring(GetPlayerLevel() or "?"))
        return
    end

    UpdateStatus("Going for quest: " .. tostring(best.NameQuest or best.NPC) .. " | mob: " .. tostring(best.Mob or "?"))

    local arrived, routeErr = TeleportToQuestNPC(best, 8)
    if not _G.Level then return end

    if routeErr == "no_entry" then
        UpdateStatus("Cavern entry failed, retry in 2s")
        return
    end

    QuestState.TakenAt = tick()
    local taken = TryStartQuest(best)

    if taken then
        local parsed = GetQuestMob(taken)
        if best.Mob and parsed and not SameMob(parsed, best.Mob) then
            UpdateStatus("Wrong quest taken (" .. parsed .. " instead of " .. best.Mob .. "), abandoning")
            pcall(function() CommF:InvokeServer("AbandonQuest") end)
            ResetQuestState()
            QuestState.LastTry = 0
            return
        end

        QuestState.Confirmed = true
        QuestState.LastSeen  = tick()
        QuestKillCount = 0
        CompleteStallSince = nil
        QuestState.Mob = best.Mob or parsed
        QuestState.DeepFish = IsDeepFishmanQuest(best)
        UpdateStatus("Quest taken: " .. taken.Name
            .. " | mob: " .. tostring(QuestState.Mob)
            .. (QuestState.DeepFish and " [underwater]" or ""))
    else
        if arrived then
            UpdateStatus("Tracker did not show quest, farming " .. tostring(best.Mob or "?") .. " (retry in " .. QUEST_GRACE .. "s)")
        else
            UpdateStatus("Did not reach NPC, retry in " .. QUEST_GRACE .. "s")
        end
    end
end

