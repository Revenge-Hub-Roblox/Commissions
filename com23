function core.findWorldFruits(minPrice)
    local list = {}
    for _, v in ipairs(workspace:GetChildren()) do
        if core.isWorldFruit(v) then
            local fid = core.getFruitId(v)
            local price = core.getFruitPrice(fid or v)
            if not minPrice or price >= minPrice then
                table.insert(list, {
                    Tool = v,
                    Handle = v:FindFirstChild("Handle"),
                    Id = fid,
                    Price = price,
                    Matched = Config.TweenServerFruit and core.fruitMatchesSelection(fid) or false,
                })
            end
        end
    end
    table.sort(list, function(a, b)
        if a.Matched ~= b.Matched then return a.Matched end
        return a.Price > b.Price
    end)
    return list
end

