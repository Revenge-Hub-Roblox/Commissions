local function GetCurrentQuest()
    local ok, res = pcall(function()
        local tracked = LocalPlayer.PlayerGui:FindFirstChild("TrackedQuestFrame")
        if not tracked then return nil end
        local frame = tracked:FindFirstChild("Frame")
        if not frame then return nil end
        local header = frame:FindFirstChild("header")
        local title = header and header:FindFirstChild("textLabel")
        local description = frame:FindFirstChild("description")
        local progress = frame:FindFirstChild("progress")
        if not title or not title:IsA("TextLabel") then return nil end
        local name = title.Text
        if name == "" or name == "---" then return nil end
        return {
            Name     = name,
            Target   = (description and description:IsA("TextLabel")) and description.Text or "",
            Progress = (progress and progress:IsA("TextLabel")) and progress.Text or "",
        }
    end)
    if ok then return res end
    return nil
end

local function ParseProgress(str)
    local a, b = (str or ""):match("(%d+)%s*/%s*(%d+)")
    if a and b then return tonumber(a), tonumber(b) end
    return nil, nil
end

local function Norm(s)
    s = (s or ""):lower():gsub("[^%w%s]", " ")
    return (s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function TextHas(text, word)
    text, word = Norm(text), Norm(word)
    if text == "" or word == "" then return false end
    return text:find(word, 1, true) ~= nil
end

local function CleanName(s)
    s = (s or ""):gsub("%b[]", " "):gsub("%d+", " "):gsub("[^%w%s]", " ")
    return Norm(s)
end

local function SameMob(enemyName, target)
    if not enemyName or not target then return false end
    if enemyName == target then return true end
    local a, b = CleanName(enemyName), CleanName(target)
    if a ~= "" and a == b then return true end
    local sa = Norm(a:gsub("boss", " "))
    local sb = Norm(b:gsub("boss", " "))
    return sa ~= "" and sa == sb
end

local function IsValidQuestMob(v, mob)
    if not SameMob(v.Name, mob) then return false end
    if v.Name == "Prisoner" and v:FindFirstChild("Accessory (Big_Chain_Around_Neck_Silver)") then
        return false
    end
    return true
end

