function core.findOwnedFruitTool(id)
    for _, bag in ipairs({ character, backpack }) do
        if bag then
            for _, t in ipairs(bag:GetChildren()) do
                if t:IsA("Tool") then
                    if id and t:GetAttribute("OriginalName") == id then return t end
                    if (t:FindFirstChild("EatRemote", true) or t:GetAttribute("OriginalName")) and not id then
                        return t
                    end
                end
            end
        end
    end
    return nil
end

