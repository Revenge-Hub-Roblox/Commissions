local function TeleportToQuestNPC(best, timeout)
    timeout = timeout or 8

    if IsDeepFishmanQuest(best) then
        if not EnterUnderwaterCity() then
            return false, "no_entry"
        end
    elseif InUnderwater() then
        ExitUnderwaterCity()
    end

    local npcModel, npcRoot
    if GuideModule and GuideModule.Data and GuideModule.Data.LastClosestNPC then
        npcModel, npcRoot = FindNPCModel(GuideModule.Data.LastClosestNPC)
    end
    if not npcRoot and best and best.NPC then
        npcModel, npcRoot = FindNPCModel(best.NPC)
    end

    if not npcRoot then
        return true
    end

    return ApproachNPC(npcRoot, timeout)
end

local function TryStartQuest(best)
    if CommF and best.NameQuest then
        pcall(function() CommF:InvokeServer("StartQuest", best.NameQuest, best.ID) end)
    else
        local npcModel, npcRoot
        if best and best.NPC then
            npcModel, npcRoot = FindNPCModel(best.NPC)
        end
        if npcRoot then
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - npcRoot.Position).Magnitude > 8 then
                ApproachNPC(npcRoot, 4)
            end
            FireNPC(npcModel)
            task.wait(0.4)
            FireNPC(npcModel)
        end
    end

    local deadline = tick() + QUEST_CONFIRM_WAIT
    while tick() < deadline do
        local q = GetCurrentQuest()
        if q then return q end
        if not _G.Level then return nil end
        task.wait(0.15)
    end
    return nil
end

