local cachedPart, cachedScreen, cachedOnScreen = nil, nil, false
local lastScanFrame = -1

local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getTargetPart(char)
    return char:FindFirstChild(cfg.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasWall(origin, targetPos, targetChar)
    if not cfg.WallCheck then return false end
    local filter = { LocalPlayer.Character, Camera }
    if targetChar then
        table.insert(filter, targetChar)
    end
    rayParams.FilterDescendantsInstances = filter
    return workspace:Raycast(origin, targetPos - origin, rayParams) ~= nil
end

local function fovToPixels()
    local vh = Camera.ViewportSize.Y
    return (cfg.FOV / Camera.FieldOfView) * (vh * 0.5)
end

local function scanTarget()
    if (tick() - (lastScanFrame > 0 and lastScanFrame or 0)) < (1 / 120) and lastScanFrame > 0 then
        return cachedPart, cachedScreen, cachedOnScreen
    end
    lastScanFrame = tick()

    local bestPart, bestScreen, bestDist = nil, nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local origin = Camera.CFrame.Position
    local fovPx = fovToPixels()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not isAlive(plr) then continue end
        if cfg.TeamCheck then
            local partnerId = LocalPlayer:GetAttribute("DuoPartnerId")
            if partnerId and (plr.UserId == partnerId or tostring(plr.UserId) == tostring(partnerId)) then continue end
        end

        local char = plr.Character
        local part = getTargetPart(char)
        if not part then continue end

        local targetPos = part.Position
        if cfg.Prediction then
            local vel = part.AssemblyLinearVelocity
            targetPos = part.Position + (vel or Vector3.zero) * cfg.PredictionAmount
        end

        local dist3D = (targetPos - origin).Magnitude
        if dist3D > cfg.MaxDistance then continue end
        if hasWall(origin, targetPos, char) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen or screenPos.Z <= 0 then continue end

        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if screenDist <= fovPx and screenDist < bestDist then
            bestDist = screenDist
            bestPart = part
            bestScreen = Vector2.new(screenPos.X, screenPos.Y)
        end
    end

    cachedPart, cachedScreen, cachedOnScreen = bestPart, bestScreen, bestPart ~= nil
    return cachedPart, cachedScreen, cachedOnScreen
end

local function getCachedTarget()
    if not cfg.Enabled then return nil end
    return scanTarget()
end

local snapline
pcall(function()
    snapline = Drawing.new("Line")
    snapline.Thickness = cfg.SnaplineThickness
