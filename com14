local EXCLUDE_PROMPTS = {
    RevivePrompt = true,
    BedSleepPrompt = true,
    CellGatePrompt = true,
    SinkPrompt = true,
    SettingsPrompt = true,
}

local promptOriginals = {}

local function isItemPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    if EXCLUDE_PROMPTS[prompt.Name] then return false end
    local p = prompt.Parent
    while p and p ~= workspace and p ~= game do
        if p:IsA("Tool") then return true end
        p = p.Parent
    end
    local action = string.lower(tostring(prompt.ActionText or ""))
    if string.find(action, "pick", 1, true)
        or string.find(action, "take", 1, true)
        or string.find(action, "grab", 1, true) then
        return true
    end
    return false
end

local function stripItemPrompt(prompt)
    if not isItemPrompt(prompt) then return end
    pcall(function()
        if not promptOriginals[prompt] then
            promptOriginals[prompt] = {
                HoldDuration = prompt.HoldDuration,
                RequiresLineOfSight = prompt.RequiresLineOfSight,
            }
        end
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    end)
end

local function restoreItemPrompts()
    for prompt, orig in pairs(promptOriginals) do
        pcall(function()
            if prompt and prompt.Parent then
                prompt.HoldDuration = orig.HoldDuration
                prompt.RequiresLineOfSight = orig.RequiresLineOfSight
            end
        end)
    end
    promptOriginals = {}
end

local promptConnections = {}

local function applyItemPrompts()
    for _, desc in ipairs(workspace:GetDescendants()) do
        stripItemPrompt(desc)
    end
end

local function startPickupNoCD()
    for _, c in ipairs(promptConnections) do pcall(function() c:Disconnect() end) end
    promptConnections = {}
    applyItemPrompts()
    table.insert(promptConnections, workspace.DescendantAdded:Connect(function(desc)
        if Misc.PickupNoCD then stripItemPrompt(desc) end
    end))
    table.insert(promptConnections, RunService.Heartbeat:Connect(function()
        if not Misc.PickupNoCD then return end
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and isItemPrompt(desc) and desc.HoldDuration > 0 then
                stripItemPrompt(desc)
            end
        end
    end))
end

local function stopPickupNoCD()
    for _, c in ipairs(promptConnections) do pcall(function() c:Disconnect() end) end
    promptConnections = {}
    restoreItemPrompts()
end

