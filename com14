end)

if snapline then
    RunService.RenderStepped:Connect(function()
        if not cfg.Enabled or not cfg.ShowSnapline then
            snapline.Visible = false
            return
        end
        local part, screen = scanTarget()
        if not part or not screen then
            snapline.Visible = false
            return
        end
        local mouse = UserInputService:GetMouseLocation()
        snapline.From = mouse
        snapline.To = screen
        snapline.Color = cfg.SnaplineColor
        snapline.Thickness = cfg.SnaplineThickness
        snapline.Transparency = cfg.SnaplineTransparency
        snapline.Visible = true
    end)
end

pcall(function()
    local mt = getrawmetatable(Mouse)
    local oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = function(self, key)
        if cfg.Enabled and (key == "Hit" or key == "Target" or key == "UnitRay") then
            local target = getCachedTarget()
            if target then
                local aimPos = target.Position
                if cfg.Prediction then
                    local vel = target.AssemblyLinearVelocity
                    aimPos = target.Position + (vel or Vector3.zero) * cfg.PredictionAmount
                end
                if key == "Hit" then
                    return CFrame.new(aimPos)
                elseif key == "Target" then
                    return target
                elseif key == "UnitRay" then
                    local origin = Camera.CFrame.Position
                    return Ray.new(origin, (aimPos - origin).Unit)
                end
            end
        end
        return oldIndex(self, key)
    end
    setreadonly(mt, true)
end)

