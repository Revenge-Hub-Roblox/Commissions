local function parseTarget(text)
    if type(text) ~= "string" then return nil end
    local upper = string.upper(text)
    if string.find(upper, "OFF", 1, true)
        or string.find(upper, "BEST SO FAR", 1, true)
        or string.find(upper, "LOCKED", 1, true)
        or string.find(upper, "TOO EARLY", 1, true)
        or string.find(upper, "TOO LATE", 1, true)
        or string.find(upper, "WAIT FOR YOUR TURN", 1, true)
        or string.find(upper, "YOUR TURN", 1, true)
        or string.find(upper, "OPPONENT", 1, true)
        or string.find(upper, "SIMON DID", 1, true) then
        return nil
    end
    local num = string.match(upper, "STOP THE CLOCK AT%s*(%d+%.?%d*)")
        or string.match(upper, "STOP AT%s*(%d+%.?%d*)")
        or string.match(upper, "AT%s*(%d+%.?%d*)")
    return num and tonumber(num) or nil
end

local function doPress(TimeClock)
    if pressed or not SS.Enabled then return end
    pressed = true
    TimeClock:FireServer("press", workspace:GetServerTimeNow())
end

local function startLoop(TimeClock)
    stopLoop()
    if not SS.Enabled or not simonSaid or not targetTime or not startTimestamp then return end
    local err = math.abs(tonumber(SS.ErrorAmount) or 0) / 100
    local signed = (math.random() > 0.5 and 1 or -1) * err
    local need = targetTime + signed
    ssConnection = RunService.Heartbeat:Connect(function()
        if not SS.Enabled or pressed or not simonSaid then stopLoop() return end
        local current = (workspace:GetServerTimeNow() - startTimestamp) * speed
        if current >= need then
            doPress(TimeClock)
            stopLoop()
        end
    end)
end

local function bindTimeClock(TimeClock)
    TimeClock.OnClientEvent:Connect(function(action, a, b, c, d, e)
        if action == "sub" then
            local parsed = parseTarget(tostring(a))
            if parsed then targetTime = parsed end
        elseif action == "begin" then
            simonSaid = (b == true)
            startTimestamp = typeof(c) == "number" and c or nil
            speed = typeof(e) == "number" and e or 1
            pressed = false
            if simonSaid and targetTime and startTimestamp and SS.Enabled then
                startLoop(TimeClock)
            else
                stopLoop()
            end
        elseif action == "warn" then
            simonSaid = false
            stopLoop()
        elseif action == "result" or action == "end" or action == "clockstop" or action == "watchend" then
            stopLoop()
            pressed = false
            if action == "result" or action == "end" then targetTime = nil end
        end
    end)
end

