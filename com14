local cfg = getgenv().SilentAim

local function isAlive(plr)
    if plr:GetAttribute("IsEliminated") == true then
        return false
    end
    local char = plr.Character
    if not char then
        return false
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return false
    end
    if hum:GetState() == Enum.HumanoidStateType.Dead then
        return false
    end
    return true
end

local function isTeammate(plr)
    if not cfg.TeamCheck then
        return false
    end
    local partnerId = LocalPlayer:GetAttribute("DuoPartnerId")
    if partnerId and (plr.UserId == partnerId or tostring(plr.UserId) == tostring(partnerId)) then
        return true
    end
    local myTeam = LocalPlayer:GetAttribute("WarTeam")
    if myTeam ~= nil and plr:GetAttribute("WarTeam") == myTeam then
        return true
    end
    return false
end

local function getTargetPart(char)
    return char:FindFirstChild(cfg.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
end

local function getRightHand()
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    return char:FindFirstChild("RightHand")
        or char:FindFirstChild("Right Arm")
        or char:FindFirstChild("RightUpperArm")
        or char:FindFirstChild("HumanoidRootPart")
end

local function getOrigin()
    local hand = getRightHand()
    if hand then
        return hand.Position
    end
    return Camera.CFrame.Position
end

local function getViewOrigin()
    local char = LocalPlayer.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head then
            return head.Position
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position + Vector3.new(0, 1.5, 0)
        end
    end
    return Camera.CFrame.Position
end

local function fovToPixels()
    local vh = Camera.ViewportSize.Y
    return (cfg.FOV / math.max(Camera.FieldOfView, 1)) * (vh * 0.5)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function hasWall(handPos, toPos, targetChar)
    if not cfg.WallCheck then
        return false
    end

    local filter = { LocalPlayer.Character, Camera }
    if targetChar then
        table.insert(filter, targetChar)
    end
    rayParams.FilterDescendantsInstances = filter

    local viewOrigin = getViewOrigin()
    if workspace:Raycast(viewOrigin, toPos - viewOrigin, rayParams) ~= nil then
        return true
    end

    local back = viewOrigin - handPos
    local startPos = handPos
    if back.Magnitude > 0.05 then
        startPos = handPos + back.Unit * math.min(1.25, back.Magnitude)
    end
    if workspace:Raycast(startPos, toPos - startPos, rayParams) ~= nil then
        return true
    end

    return false
end

local cachedPart, cachedScreen = nil, nil
local lastScan = 0

local function scanTarget()
    if tick() - lastScan < (1 / 120) and lastScan > 0 then
        return cachedPart, cachedScreen
    end
    lastScan = tick()

    local bestPart, bestScreen, bestDist = nil, nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local origin = getOrigin()
    local fovPx = fovToPixels()
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then
            continue
        end
        if not isAlive(plr) then
            continue
        end
        if isTeammate(plr) then
            continue
        end

        local char = plr.Character
        local part = getTargetPart(char)
        if not part then
            continue
        end

        local targetPos = part.Position
        if cfg.Prediction then
            local vel = part.AssemblyLinearVelocity or Vector3.zero
            targetPos = part.Position + vel * cfg.PredictionAmount
        end

        if (targetPos - origin).Magnitude > cfg.MaxDistance then
            continue
        end

        if hasWall(origin, targetPos, char) then
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen or screenPos.Z <= 0 then
            continue
        end

        local sp = Vector2.new(screenPos.X, screenPos.Y)
        local screenDist

        if cfg.AimCircle then
            screenDist = (sp - center).Magnitude
            if screenDist > cfg.AimCircleRadius then
                continue
            end
        else
            screenDist = (sp - mousePos).Magnitude
            if screenDist > fovPx then
                continue
            end
        end

        if screenDist < bestDist then
            bestDist = screenDist
            bestPart = part
            bestScreen = sp
        end
    end

    cachedPart, cachedScreen = bestPart, bestScreen
    return bestPart, bestScreen
end

local snapline = nil
local aimCircleDraw = nil

do
    local ok, line = pcall(function()
        return Drawing.new("Line")
    end)
    if ok and line then
        snapline = line
        snapline.Visible = false
        snapline.Thickness = cfg.SnaplineThickness
        snapline.Transparency = cfg.SnaplineTransparency
        snapline.Color = cfg.SnaplineColor
        snapline.ZIndex = 2
    end
end

do
    local ok, circle = pcall(function()
        return Drawing.new("Circle")
    end)
    if ok and circle then
        aimCircleDraw = circle
        aimCircleDraw.Visible = false
        aimCircleDraw.Thickness = 2
        aimCircleDraw.NumSides = 64
        aimCircleDraw.Filled = false
        aimCircleDraw.Color = Color3.fromRGB(255, 50, 50)
        aimCircleDraw.Transparency = 1
        aimCircleDraw.ZIndex = 1
    end
end

RunService.RenderStepped:Connect(function()
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)

    if aimCircleDraw then
        if cfg.Enabled and cfg.AimCircle then
            aimCircleDraw.Position = center
            aimCircleDraw.Radius = cfg.AimCircleRadius
            aimCircleDraw.Color = Color3.fromRGB(255, 50, 50)
            aimCircleDraw.Thickness = 2
            aimCircleDraw.Visible = true
        else
            aimCircleDraw.Visible = false
        end
    end

    if not snapline then
        return
    end

    if not cfg.Enabled or not cfg.ShowSnapline then
        snapline.Visible = false
        return
    end

    local part, screen = scanTarget()
    if not part or not screen then
        snapline.Visible = false
        return
    end

    local fromPos = cfg.AimCircle and center or UserInputService:GetMouseLocation()
    snapline.From = fromPos
    snapline.To = screen
    snapline.Color = cfg.SnaplineColor
    snapline.Thickness = cfg.SnaplineThickness
    snapline.Transparency = cfg.SnaplineTransparency
    snapline.Visible = true
end)

local equipConns = {}

local function disablePistolEquip(tool)
    if not tool or not tool:IsA("Tool") or tool.Name ~= "Pistol" then
        return
    end
    local eq = tool:FindFirstChild("PistolEquip")
    if eq then
        eq.Disabled = true
    end
end

local function setEquipHooks(enabled)
    for _, c in ipairs(equipConns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(equipConns)

    local function scan(container)
        if not container then
            return
        end
        for _, v in ipairs(container:GetDescendants()) do
            if v:IsA("Tool") then
                if enabled then
                    disablePistolEquip(v)
                else
                    local eq = v:FindFirstChild("PistolEquip")
                    if eq then
                        eq.Disabled = false
                    end
                end
            end
        end
    end

    if not enabled then
        scan(LocalPlayer.Character)
        scan(LocalPlayer:FindFirstChild("Backpack"))
        return
    end

    scan(LocalPlayer.Character)
    scan(LocalPlayer:FindFirstChild("Backpack"))

    local function onDesc(v)
        if v:IsA("Tool") then
            disablePistolEquip(v)
        elseif v.Name == "PistolEquip" then
            v.Disabled = true
        end
    end

    table.insert(equipConns, LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.2)
        scan(char)
        table.insert(equipConns, char.DescendantAdded:Connect(onDesc))
    end))

    if LocalPlayer.Character then
        table.insert(equipConns, LocalPlayer.Character.DescendantAdded:Connect(onDesc))
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        table.insert(equipConns, bp.DescendantAdded:Connect(onDesc))
    end
end

local function fireWeapon()
    if not cfg.Enabled then
        return
    end

    local char = LocalPlayer.Character
    if not char then
        return
    end

    local pistol = char:FindFirstChild("Pistol")
    if not pistol then
        return
    end

    local fireRequest = pistol:FindFirstChild("FireRequest")
    if not fireRequest then
        return
    end

    local targetPart = select(1, scanTarget())
    if not targetPart or not targetPart.Parent then
        return
    end

    local origin = getOrigin()
    local aimPos = targetPart.Position
    if cfg.Prediction then
        local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
        aimPos = targetPart.Position + vel * cfg.PredictionAmount
    end

    if hasWall(origin, aimPos, targetPart.Parent) then
        return
    end

    fireRequest:FireServer(origin, (aimPos - origin).Unit * 500)
end

local inputConns = {}

local function clearInput()
    for _, c in ipairs(inputConns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(inputConns)
end

local function bindInput()
    clearInput()
    table.insert(inputConns, Mouse.Button1Down:Connect(fireWeapon))

    local function hookFireButton(btn)
        if not btn then
            return
        end
        table.insert(inputConns, btn.MouseButton1Click:Connect(fireWeapon))
        pcall(function()
            table.insert(inputConns, btn.TouchTap:Connect(fireWeapon))
        end)
    end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        local dash = pg:FindFirstChild("MobileDashGui")
        if dash then
            hookFireButton(dash:FindFirstChild("FireButton"))
        end
        table.insert(inputConns, pg.DescendantAdded:Connect(function(obj)
            if obj.Name == "FireButton" then
                hookFireButton(obj)
            end
        end))
    end
end

