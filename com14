    end)

    if not ok or not TimeClock then
        return
    end

    TimeClock.OnClientEvent:Connect(function(action, a, b, c, d, e)
        if action == "sub" then
            local parsed = parseTarget(tostring(a))
            if parsed then
                targetTime = parsed
            end
        elseif action == "begin" then
            simonSaid = (b == true)
            startTimestamp = typeof(c) == "number" and c or nil
            speed = typeof(e) == "number" and e or 1
            pressed = false
            if simonSaid and targetTime and startTimestamp and SS.Enabled then
                startLoop(TimeClock)
            else
                stopLoop()
            end
        elseif action == "warn" then
            simonSaid = false
            stopLoop()
        elseif action == "result" or action == "end" or action == "clockstop" or action == "watchend" then
            stopLoop()
            pressed = false
            if action == "result" or action == "end" then
                targetTime = nil
            end
        end
    end)
end)

