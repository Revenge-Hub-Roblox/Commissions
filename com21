local function isSellOptionText(text)
    local t = string.lower(tostring(text or ""))

    if t:find("i'd like to sell", 1, true) then
        return true
    end

    if t:find("i would like to sell", 1, true) then
        return true
    end

    if t:find("id like to sell", 1, true) then
        return true
    end

    if t:find("sell this", 1, true) then
        return true
    end

    if t:find("sell all", 1, true) then
        return true
    end

    if t:find("all of these", 1, true) then
        return true
    end

    if t:find("deal", 1, true) then
        return true
    end

    return false
end

local function findClientFunctionsModule()
    local found = nil

    if getnilinstances then
        for _, obj in ipairs(getnilinstances()) do
            if obj:IsA("ModuleScript")
                and obj.Name:lower():find("clientfunc") then

                local ok, mod = pcall(require, obj)

                if ok
                    and type(mod) == "table"
                    and mod.DialogueType then

                    found = mod
                    break
                end
            end
        end
    end

    if found then
        return found
    end

    pcall(function()
        for _, obj in ipairs(
            game:GetService("ReplicatedStorage"):GetDescendants()
        ) do
            if obj:IsA("ModuleScript") then
                local n = obj.Name:lower()

                if n:find("clientfunc", 1, true)
                    or n:find("dialog", 1, true) then

                    local ok, mod = pcall(require, obj)

                    if ok
                        and type(mod) == "table"
                        and mod.DialogueType then

                        found = mod
                        break
                    end
                end
            end
        end
    end)

    return found
end

local function setupSellHook()
    if sellHookOk then
        return true
    end

    local ClientFunctions = findClientFunctionsModule()

    if not ClientFunctions then
        return false
    end

    local oldDialogueType = ClientFunctions.DialogueType

    local hookFn = function(args)
        sellHookCalls += 1

        if not args or type(args.Options) ~= "table" then
            return oldDialogueType(args)
        end

        local selected = nil

        for _, opt in pairs(args.Options) do
            local val = tostring(
                opt.Value
                or opt.Text
                or opt.Label
                or ""
            )

            if isSellOptionText(val) then
                selected = opt.Name
                break
            end
        end

        if not selected
            and getgenv().AutoAnswerAllDialogues ~= false then

            local first = args.Options[1]

            if not first then
                for _, opt in pairs(args.Options) do
                    first = opt
                    break
                end
            end

            if first then
                selected = first.Name
            end
        end

        if selected then
            return {
                Option = selected
            }
        end

        return oldDialogueType(args)
    end

    local ok = pcall(function()
        ClientFunctions.DialogueType = hookFn
    end)

    if not ok then
        print("[SellHook] Failed to override DialogueType (module frozen?)")
        return false
    end

    sellHookOk = true

    print("[SellHook] DialogueType hooked → all sell dialogues answer instantly")

    return true
end

