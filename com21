        return false
    end

    fireClick(b1)
    task.wait(0.5)

    local b2 =
        waitOption("deal", 5)
        or waitOption("yes", 2)
        or waitOption("confirm", 2)

    if not b2 then
        print("[Sell] DEBUG: no 'deal' option")
        return false
    end

    fireClick(b2)
    task.wait(0.5)

    local b3 =
        waitOption("sell all", 5)
        or waitOption("all of these", 3)
        or waitOption("all", 2)

    if not b3 then
        print("[Sell] DEBUG: no 'sell all' option")
        return false
    end

    fireClick(b3)
    task.wait(0.5)

    return true
end

local function getSellPriorityList()
    local list = {}

    for _, info in ipairs(items_to_farm) do
        if isSellable(info.Name) then
            local count = countTool(info.Name)

            if count > 0 then
                local ratio = count / info.Limit
                local isFull = count >= info.Limit

                table.insert(list, {
                    Name = info.Name,
                    Count = count,
                    Limit = info.Limit,
                    Ratio = ratio,
                    IsFull = isFull
                })

                if isFull then
                    print(string.format(
                        "[Sell] FULL detected: %s (%d/%d)",
                        info.Name,
                        count,
                        info.Limit
                    ))
                end
            end
        end
    end

    table.sort(list, function(a, b)
        if a.IsFull ~= b.IsFull then
            return a.IsFull
        end

        return a.Ratio > b.Ratio
    end)

    return list
end

local function hasHigherPriority(currentName)
    local list = getSellPriorityList()

    if #list == 0 then
        return false
    end

    if list[1].Name ~= currentName and list[1].IsFull then
        return true
    end

    return false
end

local function sellOneType(toolName)
    if not isSellable(toolName) then
        print("[Sell] BLOCKED by SellItems:", toolName)
        return false
    end

    local maxAttempts = 5

    for attempt = 1, maxAttempts do
        if not isSellable(toolName) then
            print("[Sell] Item disabled in SellItems:", toolName)
            closeDialogue()
            return false
        end

        if hasHigherPriority(toolName) then
            print("[Sell] Higher priority item detected → switching")
            closeDialogue()
            return false
        end

        local before = countTool(toolName)

        if before <= 0 then
            return true
        end

        print(
            "[Sell] Attempt",
            attempt,
            "for",
            toolName,
            "| have:",
            before,
            "| hook:",
            sellHookOk and "ON" or "OFF"
        )

        if not ensureEquipped(toolName) then
            print("[Sell] DEBUG: failed to equip", toolName)
            closeDialogue()
            task.wait(0.3)
            continue
        end

        if not startMerchantTalk() then
            print("[Sell] DEBUG: failed to open merchant dialogue")
            closeDialogue()
            task.wait(0.4)
            continue
        end

        ensureEquipped(toolName)
        task.wait(0.1)

        local ok = runSellOptions()

        if not ok then
            print("[Sell] DEBUG: dialogue chain failed")
            closeDialogue()
            task.wait(0.5)
            continue
        end

        local sold = false
        local guiFallbackDone = false

        local t0 = tick()

        local waitMax = sellHookOk and 4 or 2

        while tick() - t0 < waitMax do
            task.wait(0.1)

            if countTool(toolName) < before then
                sold = true
                break
            end

            if sellHookOk
                and not guiFallbackDone
                and (tick() - t0) > 1.2
                and hasDialogue() then

                guiFallbackDone = true

                print("[Sell] Hook missed a dialogue step → GUI fallback")

                task.spawn(function()
                    pcall(function()
                        runSellOptions(true)
                    end)
                end)
            end
        end

        if sold then
            print("[Sell] OK sold", toolName)
            closeDialogue()

            if hasHigherPriority(toolName) then
                return false
            end

            return true
        else
            print("[Sell] DEBUG: item still present after wait → retry")
            closeDialogue()
            task.wait(0.6)
        end
    end

    print("[Sell] FAILED after", maxAttempts, "attempts:", toolName)
    closeDialogue()

    return false
end

local function sellLoop()
    print("[Sell] continuous (priority by fill %)")

    while true do
        if getgenv().AutoSell then
            local priorityList = getSellPriorityList()

            if #priorityList > 0 then
                local top = priorityList[1]

                print(string.format(
                    "[Sell] Priority → %s (%d/%d) %s",
                    top.Name,
                    top.Count,
                    top.Limit,
                    top.IsFull and "[FULL]" or ""
                ))

                if top.IsFull then
                    print("[Sell] Trying to sell FULL stack of", top.Name)
                end

                local success = pcall(sellOneType, top.Name)

                if not success then
                    print("[Sell] sellOneType errored for", top.Name)
                end

                task.wait(getgenv().SellGap or 0.4)
            else
                task.wait(getgenv().SellRetryEmpty or 2)
            end
        else
            task.wait(1)
        end
    end
end

