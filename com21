local function writeMyPresence(sidOverride)
    local now = os.time()

    for sid, t in pairs(myPresence.full) do
        if (now - (tonumber(t) or 0)) > FULL_EXPIRY then
            myPresence.full[sid] = nil
        end
    end

    myPresence.t = now
    myPresence.s = tostring(sidOverride or game.JobId)

    if useFS then
        pcall(function()
            writefile(
                ACC_DIR .. "/acc_" .. LP.UserId .. ".json",
                HttpService:JSONEncode(myPresence)
            )
        end)
    end
end

local function forEachOtherAccount(exceptUserId, cb)
    if not useDir then
        return
    end

    if not isfolder(ACC_DIR) then
        return
    end

    local ok, files = pcall(listfiles, ACC_DIR)

    if not ok or type(files) ~= "table" then
        return
    end

    local now = os.time()

    for _, path in ipairs(files) do
        if tostring(path):find("acc_", 1, true) then
            local ok2, data = pcall(function()
                return HttpService:JSONDecode(readfile(path))
            end)

            if ok2
                and type(data) == "table"
                and tonumber(data.u)
                and tonumber(data.u) ~= exceptUserId
                and (now - (tonumber(data.t) or 0)) <= PRESENCE_EXPIRY then

                cb(data)
            end
        end
    end
end

local function anyAccountOnServer(sid, exceptUserId)
    local found = false

    forEachOtherAccount(exceptUserId, function(d)
        if tostring(d.s) == tostring(sid) then
            found = true
        end
    end)

    return found
end

local function getAccountsOnServer(sid, exceptUserId)
    local res = {}

    forEachOtherAccount(exceptUserId, function(d)
        if tostring(d.s) == tostring(sid) then
            table.insert(res, tonumber(d.u))
        end
    end)

    return res
end

local function isRecentlyFull(sid)
    local now = os.time()
    local hit = false

    forEachOtherAccount(-1, function(d)
        local t = type(d.full) == "table" and d.full[tostring(sid)]

        if t and (now - (tonumber(t) or 0)) <= FULL_EXPIRY then
            hit = true
        end
    end)

    if not hit then
        local t = myPresence.full[tostring(sid)]

        if t and (now - t) <= FULL_EXPIRY then
            hit = true
        end
    end

    return hit
end

local function markServerFull(sid)
    myPresence.full[tostring(sid)] = os.time()

    writeMyPresence()

    print("[Hop] Marked FULL for", FULL_EXPIRY, "s:", sid)
end

task.spawn(function()
