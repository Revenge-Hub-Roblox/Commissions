local VISITED_FILE = "visited_servers_v2.json"
local HOP_LOCK_FOLDER = "serverhop.lock"
local PlaceId = game.PlaceId



local VISITED_TTL = 10 * 60
local RESERVATION_TTL = 15
local LOCK_TTL = 8
local HOP_MAX_TRIES = 12
local TELEPORT_GRACE = 10
local API_RETRY_DELAY = 0.45
local SAME_TARGET_COOLDOWN = 1.25

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local LP = game.Players.LocalPlayer

local clientToken = tostring(LP.UserId) .. ":" .. tostring(game.JobId) .. ":" .. tostring(math.random(100000, 999999))
local cursor = ""
local lastTriedServer = nil
local teleportInProgress = false
local teleportFailed = false
local teleportFailureMessage = nil
