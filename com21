local function now()
    return os.time()
end

local function safeReadState()
    if not isfile or not isfile(VISITED_FILE) then
        return {
            version = 2,
            visited = {},
            reserved = {}
        }
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(VISITED_FILE))
    end)

    if ok and type(data) == "table" then
        data.version = 2
        data.visited = type(data.visited) == "table" and data.visited or {}
        data.reserved = type(data.reserved) == "table" and data.reserved or {}
        return data
    end

    return {
        version = 2,
        visited = {},
        reserved = {}
    }
end

local function safeWriteState(data)
    if not writefile then
        return false
    end

    local ok = pcall(function()
        writefile(VISITED_FILE, HttpService:JSONEncode(data))
    end)

    return ok
end

local function acquireStateLock(timeout)
    timeout = timeout or 2

    if not (makefolder and isfolder and delfolder) then
        return true, false
    end

    local started = tick()

    while tick() - started < timeout do
        local created = pcall(function()
            makefolder(HOP_LOCK_FOLDER)
        end)

        if created and isfolder(HOP_LOCK_FOLDER) then

            if writefile then
                pcall(function()
                    writefile(HOP_LOCK_FOLDER .. "/owner.txt", clientToken .. "|" .. tostring(now()))
                end)
            end

            return true, true
        end

        task.wait(0.035 + math.random() * 0.055)
    end

    return false, true
end

local function releaseStateLock(locked)
    if not locked then
        return
    end

    if delfolder and isfolder and isfolder(HOP_LOCK_FOLDER) then
        pcall(function()
            delfolder(HOP_LOCK_FOLDER)
        end)
    end
end

local function pruneState(data, currentTime)
    currentTime = currentTime or now()

    for sid, stamp in pairs(data.visited) do
        if type(stamp) ~= "number" or currentTime - stamp >= VISITED_TTL then
            data.visited[sid] = nil
        end
    end

    for sid, reservation in pairs(data.reserved) do
        if type(reservation) ~= "table"
            or type(reservation.expires) ~= "number"
            or reservation.expires <= currentTime then
            data.reserved[sid] = nil
        end
    end
end

local function updateState(mutator)
    local locked, lockSupported = acquireStateLock(2)

    if not locked and lockSupported then
        return false
    end

    local ok, result = pcall(function()
        local data = safeReadState()
        pruneState(data)
        local value = mutator(data)
        safeWriteState(data)
        return value
    end)

    releaseStateLock(lockSupported and locked)

    if not ok then
        return false
    end

    return result
end

local function isServerVisited(sid)
    sid = tostring(sid)

    local locked, lockSupported = acquireStateLock(1)
    if not locked and lockSupported then
        return true
    end

    local data = safeReadState()
    pruneState(data)
    local result = type(data.visited[sid]) == "number"
        and now() - data.visited[sid] < VISITED_TTL

    safeWriteState(data)
    releaseStateLock(lockSupported and locked)

    return result
end

local function reserveServer(sid)
    sid = tostring(sid)

    return updateState(function(data)
        local current = now()
        local reservation = data.reserved[sid]

        if reservation
            and reservation.owner ~= clientToken
            and type(reservation.expires) == "number"
            and reservation.expires > current then
            return false
        end

        data.reserved[sid] = {
            owner = clientToken,
            expires = current + RESERVATION_TTL
        }


        data.visited[sid] = current
        return true
    end) == true
end

local function releaseReservation(sid, markCooldown)
    if not sid then
        return
    end

    sid = tostring(sid)

    updateState(function(data)
        local reservation = data.reserved[sid]

        if reservation and reservation.owner == clientToken then
            data.reserved[sid] = nil
        end

        if markCooldown then
            data.visited[sid] = now()
        end
    end)
end

local function markCurrentServer(sid)
    if not sid or sid == "" or sid == "0" then
        return
    end

    sid = tostring(sid)

    updateState(function(data)
        data.visited[sid] = now()
        local reservation = data.reserved[sid]
        if reservation and reservation.owner == clientToken then
            data.reserved[sid] = nil
        end
    end)

    print("[Hop] Marked current server:", sid)
end

local function countOtherReservations(data, sid)
    local reservation = data.reserved[tostring(sid)]
    if not reservation then
        return 0
    end

    if reservation.owner == clientToken then
        return 0
    end

    if type(reservation.expires) ~= "number" or reservation.expires <= now() then
        return 0
    end

    return 1
end

local function getServerState(sid)
    sid = tostring(sid)

    local locked, lockSupported = acquireStateLock(1)
    if not locked and lockSupported then
        return true, 1
    end

    local data = safeReadState()
    pruneState(data)

    local visited = data.visited[sid] ~= nil
    local reserved = countOtherReservations(data, sid)

    safeWriteState(data)
    releaseStateLock(lockSupported and locked)

    return visited, reserved
end

local function getStateSnapshot()
    local locked, lockSupported = acquireStateLock(1)
    if not locked and lockSupported then
        return nil
    end

    local data = safeReadState()
    pruneState(data)

    local snapshot = {
        visited = {},
        reserved = {}
    }

    for sid, stamp in pairs(data.visited) do
        snapshot.visited[tostring(sid)] = stamp
    end

    for sid, reservation in pairs(data.reserved) do
        if type(reservation) == "table"
            and type(reservation.expires) == "number"
            and reservation.expires > now() then
            snapshot.reserved[tostring(sid)] = reservation
        end
    end

    safeWriteState(data)
    releaseStateLock(lockSupported and locked)

    return snapshot
end

