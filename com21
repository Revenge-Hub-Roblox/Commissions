do
    local Lighting = game:GetService("Lighting")
    local Workspace = game:GetService("Workspace")

    local Saved = {}

    local function Save(Object, Property)
        if not Object then
            return
        end

        Saved[Object] = Saved[Object] or {}

        if Saved[Object][Property] == nil then
            local ok, val = pcall(function()
                return Object[Property]
            end)

            if ok then
                Saved[Object][Property] = val
            end
        end
    end

    local function Set(Object, Property, Value)
        if not Object then
            return
        end

        Save(Object, Property)

        pcall(function()
            Object[Property] = Value
        end)
    end

    local function OptimizeLighting(Object)
        if Object == Lighting then
            Set(Object, "GlobalShadows", false)

            pcall(function()
                Set(Object, "FogEnd", 1000000)
            end)

            pcall(function()
                Set(Object, "Brightness", 0)
            end)

            return
        end

        if Object:IsA("PointLight")
            or Object:IsA("SpotLight")
            or Object:IsA("SurfaceLight") then

            Set(Object, "Enabled", false)

            pcall(function()
                Set(Object, "Brightness", 0)
            end)
        end

        if Object:IsA("PostEffect") then
            Set(Object, "Enabled", false)
        end
    end

    local function OptimizeTextures(Object)
        if Object:IsA("Decal")
            or Object:IsA("Texture") then

            Set(Object, "Transparency", 1)

            return
        end

        if Object:IsA("SurfaceAppearance") then
            Set(Object, "Enabled", false)
            return
        end

        if Object:IsA("BasePart") then
            pcall(function()
                Set(Object, "Reflectance", 0)
            end)

            pcall(function()
                Set(Object, "CastShadow", false)
            end)

            pcall(function()
                Set(Object, "Material", Enum.Material.Plastic)
            end)
        end
    end

    local function OptimizeEffects(Object)
        if Object:IsA("ParticleEmitter")
            or Object:IsA("Trail")
            or Object:IsA("Beam")
            or Object:IsA("Smoke")
            or Object:IsA("Fire")
            or Object:IsA("Sparkles") then

            Set(Object, "Enabled", false)

            return
        end

        if Object:IsA("PostEffect") then
            Set(Object, "Enabled", false)
        end
    end

    local function OptimizeTerrain()
        local Terrain = Workspace:FindFirstChildOfClass("Terrain")

        if Terrain then
            pcall(function()
                Set(Terrain, "Decoration", false)
            end)
        end
    end

    local function ApplyExtreme()
        OptimizeLighting(Lighting)

        for _, Object in ipairs(Workspace:GetDescendants()) do
            OptimizeLighting(Object)
            OptimizeTextures(Object)
            OptimizeEffects(Object)

            if Object:IsA("BasePart") then
                pcall(function()
                    Set(Object, "CastShadow", false)
                end)

                pcall(function()
                    Set(Object, "Reflectance", 0)
                end)

                pcall(function()
                    Set(Object, "Material", Enum.Material.Plastic)
                end)
            end
        end

        for _, Object in ipairs(Lighting:GetDescendants()) do
            OptimizeLighting(Object)
            OptimizeEffects(Object)
        end

        OptimizeTerrain()
    end

    task.spawn(ApplyExtreme)

    Workspace.DescendantAdded:Connect(function(Object)
        task.defer(function()
            if Object and Object.Parent then
                OptimizeLighting(Object)
                OptimizeTextures(Object)
                OptimizeEffects(Object)
            end
        end)
