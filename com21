    for _, item in pairs(folder:GetChildren()) do
        if item:FindFirstChild("MeshPart")
            and item:FindFirstChild("ProximityPrompt") then

            if item.ProximityPrompt.ObjectText == itemName
                and item.ProximityPrompt.MaxActivationDistance == 8 then

                table.insert(result.ProximityPrompt, item.ProximityPrompt)
                table.insert(result.Position, item.MeshPart.CFrame)
            end
        end
    end

    return result
end

local function collectItem(spawnData, index)
    local collected = false

    local timeout =
        (getgenv().waitUntilCollect or 0.5) + 4

    local char = LP.Character

    if char
        and char:FindFirstChild("SummonedStand")
        and char.SummonedStand.Value then

        pcall(function()
            local rf = char:FindFirstChild("RemoteFunction")

            if rf then
                rf:InvokeServer("ToggleStand", "Toggle")
            end
        end)
    end

    local conn

    conn = LP.Backpack.ChildAdded:Connect(function()
        collected = true

        if conn then
            conn:Disconnect()
        end
    end)

    task.spawn(function()
        while not collected do
            task.wait()

            pcall(function()
                local hrp =
                    LP.Character
                    and LP.Character:FindFirstChild("HumanoidRootPart")

                if hrp and spawnData.Position[index] then
                    hrp.CFrame =
                        spawnData.Position[index]
                        - Vector3.new(0, 8, 0)
                end
            end)
        end
    end)

    task.wait(getgenv().waitUntilCollect or 0.5)

    task.spawn(function()
        for _ = 1, 8 do
            pcall(function()
                if spawnData.ProximityPrompt[index] then
                    fireproximityprompt(
                        spawnData.ProximityPrompt[index]
                    )
                end
            end)

            task.wait(0.12)
        end
    end)

    task.spawn(function()
        task.wait(timeout)
        collected = true
    end)

    while not collected do
        task.wait()
    end

    if conn then
        conn:Disconnect()
    end
end

local lastItemSeen = tick()

local function farmLoop()
    print("[Farm] started")

    while true do
        local any = false

        for _, info in ipairs(items_to_farm) do
            local spawns = getItemSpawns(info.Name)

            if #spawns.Position > 0 then
                any = true
                lastItemSeen = tick()

                print("[Farm] Collecting:", info.Name, #spawns.Position)

                for i = 1, #spawns.Position do
                    collectItem(spawns, i)
                    task.wait(0.15)
                end
            end

            task.wait(0.05)
        end

        if any then
            lastItemSeen = tick()
            task.wait(0.2)
        else
            if getgenv().HopWhenNoItems
                and (tick() - lastItemSeen)
                    >= (getgenv().NoItemsTimeout or 5) then

                print(
                    "[Farm] No items for",
                    math.floor(tick() - lastItemSeen),
                    "s → hopping"
                )

                hopServer()

                task.wait(8)
                lastItemSeen = tick()
            else
                task.wait(0.5)
            end
        end
    end
end

local function fireClick(btn)
    if not btn then
        return false
    end

    if getconnections then
        for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
            pcall(function()
                if c.Fire then
                    c:Fire()
                elseif c.Function then
                    c.Function()
                end
            end)
        end
    else
        pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end)
    end

    return true
end

local function waitOption(substr, timeout)
    timeout = timeout or 5

    local t0 = tick()

    substr = string.lower(substr)

    while tick() - t0 < timeout do
        local gui = LP.PlayerGui:FindFirstChild("DialogueGui")

        if gui
            and gui.Frame
            and gui.Frame:FindFirstChild("Options") then

            for _, opt in ipairs(gui.Frame.Options:GetChildren()) do
                local btn = opt:FindFirstChild("TextButton")

                if btn
                    and btn.Text
                    and string.find(
                        string.lower(btn.Text),
                        substr,
                        1,
                        true
                    ) then

                    return btn
                end
            end
        end

        task.wait(0.05)
    end

    return nil
end

local function hasDialogue()
    return LP.PlayerGui:FindFirstChild("DialogueGui") ~= nil
end

local function dialogueStarted(callsBefore)
    if sellHookOk
        and sellHookCalls > (callsBefore or 0) then

        return true
    end

    return hasDialogue()
end

local function findTool(toolName)
    local target = string.lower(toolName)

    local function search(parent)
        if not parent then
            return nil
        end

        local exact = parent:FindFirstChild(toolName)

        if exact and exact:IsA("Tool") then
            return exact
        end

        for _, t in ipairs(parent:GetChildren()) do
            if t:IsA("Tool") then
                if string.lower(t.Name) == target then
                    return t
                end
            end
        end

        return nil
    end

    return search(LP.Character)
        or search(LP:FindFirstChild("Backpack"))
end

local function countTool(toolName)
    local c = 0

    local target = string.lower(toolName)

    local function scan(parent)
        if not parent then
            return
        end

        for _, t in ipairs(parent:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)

                if n == target
                    or string.find(n, target, 1, true) then

                    c += 1
                end
            end
        end
    end

    scan(LP:FindFirstChild("Backpack"))
    scan(LP.Character)

    return c
end

local function isSellable(name)
    if not name then
        return false
    end

    local config = getgenv().SellItems

    if type(config) ~= "table" then
        return false
    end

    if config[name] ~= nil then
        return config[name] == true
    end

    local target = string.lower(tostring(name))

    for itemName, enabled in pairs(config) do
        if string.lower(tostring(itemName)) == target then
            return enabled == true
        end
    end

    return false
end

local function ensureEquipped(toolName)
    local char = LP.Character

    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not hum then
        return false
    end

    local equipped = findTool(toolName)

    if equipped and equipped.Parent == char then
        return true
    end

    local tool = findTool(toolName)

    if not tool then
        print("[Sell] DEBUG: tool not found:", toolName)
        return false
    end

    hum:EquipTool(tool)

    task.wait(getgenv().EquipTime or 0.75)

    return tool.Parent == char
end

local function startMerchantTalk()
    local re =
        LP.Character
        and LP.Character:FindFirstChild("RemoteEvent")

    if not re then
        return false
    end

    local callsBefore = sellHookCalls

    local merchantData = getMerchantData()

    if merchantData then
        pcall(function()
            re:FireServer("PromptTriggered", merchantData)
        end)

        local t0 = tick()

        while tick() - t0 < 0.8 do
            task.wait(0.1)

            if dialogueStarted(callsBefore) then
                print("[Sell] Dialogue started via PromptTriggered(instance)")
                return true
            end
        end
    end

    pcall(function()
        re:FireServer("PromptTriggered", "Merchant")
    end)

    do
        local t0 = tick()

        while tick() - t0 < 0.8 do
            task.wait(0.1)

            if dialogueStarted(callsBefore) then
                print("[Sell] Dialogue started via PromptTriggered(string)")
                return true
            end
        end
    end

    local model =
        workspace.Dialogues
        and workspace.Dialogues:FindFirstChild(
            "ShiftPlox, The Travelling Merchant"
        )

    if model then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local cb = sellHookCalls

                pcall(function()
                    fireproximityprompt(d)
                end)

                local t0 = tick()

                while tick() - t0 < 0.6 do
                    task.wait(0.1)

                    if dialogueStarted(cb) then
                        print("[Sell] Dialogue started via ProximityPrompt")
                        return true
                    end
                end
            end
        end
    end

    print("[Sell] DEBUG: all dialogue-start methods failed")

    return false
end

local function closeDialogue()
    pcall(function()
        local gui = LP.PlayerGui:FindFirstChild("DialogueGui")

        if gui then
            gui:Destroy()
        end
    end)
end

local function runSellOptions(forceGui)
    if sellHookOk and not forceGui then
        return true
    end

    local b1 =
        waitOption("sell this", 5)
        or waitOption("sell", 3)

    if not b1 then
