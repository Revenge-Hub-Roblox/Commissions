        return res
    end

    return nil
end

local function distToRange(p, minP, maxP)
    if p < minP then
        return minP - p
    end

    if p > maxP then
        return p - maxP
    end

    return 0
end

local function hopServer(force)
    if hopInProgress and not force then
        print("[Hop] Already in progress → skip")
        return
    end

    if force then
        hopInProgress = false
    end

    hopInProgress = true

    task.wait(math.random() + (LP.UserId % 10) * 0.15)

    cursor = ""
    SharedHop.failed = false
    SharedHop.full = false

    local MIN_P = getgenv().HopMinPlayers or 8
    local MAX_P = getgenv().HopMaxPlayers or 15
    local SCAN_PAGES = getgenv().HopScanPages or 5
    local TARGET = getgenv().HopTargetPlayers

    print(string.format(
        "[Hop] Target range %d-%d players, scanning %d pages...",
        MIN_P, MAX_P, SCAN_PAGES
    ))

    local candidates = {}
    local pagesFetched = 0

    while pagesFetched < SCAN_PAGES do
        local page = nil

        for try = 1, 3 do
            page = fetchServers(cursor)

            if page then
                break
            end

            print("[Hop] Fetch failed, retry", try, "...")
            task.wait(1.5 * try)
        end

        if not page then
            pagesFetched += 1
            cursor = ""
            break
        end

        cursor = (type(page.nextPageCursor) == "string"
            and page.nextPageCursor ~= "")
            and page.nextPageCursor
            or ""

        pagesFetched += 1

        for _, srv in ipairs(page.data) do
            local sid = tostring(srv.id)

            if sid ~= tostring(game.JobId) then
                local playing = tonumber(srv.playing) or 0
                local maxP = tonumber(srv.maxPlayers) or 0

                if maxP > playing
                    and not anyAccountOnServer(sid, LP.UserId)
                    and not isRecentlyFull(sid) then

                    table.insert(candidates, {
                        id = sid,
                        playing = playing,
                        max = maxP,
                        inRange = playing >= MIN_P
                            and playing <= MAX_P
                    })
                end
            end
        end

        if cursor == "" then
            break
        end

        task.wait(0.3)
    end

    table.sort(candidates, function(a, b)
        if a.inRange ~= b.inRange then
            return a.inRange
        end

        if a.inRange then
            if TARGET then
                local ta = math.abs(a.playing - TARGET)
                local tb = math.abs(b.playing - TARGET)

                if ta ~= tb then
                    return ta < tb
                end
            end

            return a.playing > b.playing
        end

        local da = distToRange(a.playing, MIN_P, MAX_P)
        local db = distToRange(b.playing, MIN_P, MAX_P)

        if da ~= db then
            return da < db
        end

        return a.playing > b.playing
    end)

    local inRangeCount = 0

    for _, c in ipairs(candidates) do
        if c.inRange then
            inRangeCount += 1
        end
    end

    print(string.format(
        "[Hop] %d candidates total, %d in range %d-%d",
        #candidates,
        inRangeCount,
        MIN_P,
        MAX_P
    ))

    local candidatesTried = 0
    local fallbackReason = "no candidates"

    for _, cand in ipairs(candidates) do
        candidatesTried += 1

        if candidatesTried > MAX_CANDIDATES then
            fallbackReason = "candidate limit"
            break
        end

        if anyAccountOnServer(cand.id, LP.UserId) or isRecentlyFull(cand.id) then
            continue
        end

        SharedHop.failed = false
        SharedHop.full = false
        lastTeleportResult = nil

        print(string.format(
            "[Hop] Teleport → %s (%d/%d)%s [%d/%d]",
            cand.id,
            cand.playing,
            cand.max,
            cand.inRange and " ★" or " (fallback)",
            candidatesTried,
            MAX_CANDIDATES
        ))

        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                cand.id,
                LP
            )
        end)

        if not ok then
            print("[Hop] Teleport call errored → next")
            task.wait(0.5)
            continue
        end

        local t0 = tick()

        while tick() - t0 < 8 do
            if SharedHop.failed or SharedHop.full then
                break
            end
            task.wait(0.25)
        end

        if SharedHop.failed or SharedHop.full then
            if SharedHop.full
                or lastTeleportResult == Enum.TeleportResult.GameIsFull then

                markServerFull(cand.id)
                print("[Hop] FULL → next candidate")
            else
                print("[Hop] Failed → next candidate")
            end

            if lastTeleportResult == Enum.TeleportResult.Floodchecked then
                task.wait(4)
            else
                task.wait(0.3)
            end

            continue
        end

        print("[Hop] No result in 8s → moving on")
        task.wait(0.5)
        continue
    end

    if candidatesTried > 0 and fallbackReason == "no candidates" then
        fallbackReason = "all candidates exhausted"
    end

    print("[Hop] Fallback rejoin:", fallbackReason)

    for _ = 1, 3 do
        local ok = pcall(function()
            TeleportService:Teleport(PlaceId, LP)
        end)

        if ok then
            return
        end

        task.wait(3)
    end

    hopInProgress = false
end

