local function findTool(toolName)
    local target = string.lower(toolName)

    local function search(parent)
        if not parent then
            return nil
        end

        local exact = parent:FindFirstChild(toolName)

        if exact and exact:IsA("Tool") then
            return exact
        end

        for _, t in ipairs(parent:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)


                if n == target then
                    return t
                end
            end
        end

        return nil
    end

    return search(LP.Character)
        or search(LP:FindFirstChild("Backpack"))
end

local function countTool(toolName)
    local c = 0

    local target = string.lower(toolName)

    local function scan(parent)
        if not parent then
            return
        end

        for _, t in ipairs(parent:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)



                if n == target
                    or string.find(n, target, 1, true) then

                    c += 1
                end
            end
        end
    end

    scan(LP:FindFirstChild("Backpack"))
    scan(LP.Character)

    return c
end



local function isSellable(name)
    if not name then
        return false
    end

    local config = getgenv().SellItems

    if type(config) ~= "table" then
        return false
    end

    if config[name] ~= nil then
        return config[name] == true
    end


    local target = string.lower(tostring(name))

    for itemName, enabled in pairs(config) do
        if string.lower(tostring(itemName)) == target then
            return enabled == true
        end
    end


    return false
end



local function ensureEquipped(toolName)
    local char = LP.Character

    local hum =
        char
        and char:FindFirstChildOfClass("Humanoid")

    if not char or not hum then
        return false
    end

    local equipped = findTool(toolName)

    if equipped
        and equipped.Parent == char then

        return true
    end

    local tool = findTool(toolName)

    if not tool then
        print(
            "[Sell] DEBUG: tool not found:",
            toolName
        )

        return false
    end

    hum:EquipTool(tool)

    task.wait(
        getgenv().EquipTime or 0.75
    )

    return tool.Parent == char
end



