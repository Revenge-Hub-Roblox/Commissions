local function teleportToServer(sid)
    teleportGeneration += 1
    local generation = teleportGeneration

    teleportInProgress = true
    getgenv().__FarmTeleporting = true
    teleportFailed = false
    teleportFailureMessage = nil

    local callOk, callErr = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            sid,
            LP
        )
    end)

    if not callOk then
        teleportInProgress = false
        getgenv().__FarmTeleporting = false
        print("[Hop] Teleport call failed:", tostring(callErr))
        releaseReservation(sid, true)
        return false
    end

    print("[Hop] Teleport request accepted for:", sid)


    local started = tick()
    while tick() - started < TELEPORT_GRACE do
        if teleportFailed then
            return false
        end

        if tostring(game.JobId) == tostring(sid) then
            teleportInProgress = false
            getgenv().__FarmTeleporting = true
            return true
        end


        if generation ~= teleportGeneration then
            return false
        end

        task.wait(0.15)
    end


    print("[Hop] Teleport still pending after 10s; keeping reservation and stopping retries")
    return true
end

local function fetchServerPage()
    local url =
        "https://games.roblox.com/v1/games/"
        .. PlaceId
        .. "/servers/Public?sortOrder="
        .. tostring(getgenv().sortOrder or "Desc")
        .. "&limit=100"

    if cursor ~= "" then
        url = url .. "&cursor=" .. cursor
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
        return nil
    end

    if data.nextPageCursor and data.nextPageCursor ~= "null" then
        cursor = tostring(data.nextPageCursor)
    else
        cursor = ""
    end

    return data.data
end

local function hopServer(force)
    if teleportInProgress then
        print("[Hop] Teleport already in progress, skipping")
        return false
    end


    task.wait(math.random(5, 35) / 100)

    print("[Hop] Searching for fullest available server...")

    local tries = 0
    while tries < HOP_MAX_TRIES do
        tries += 1

        local servers = fetchServerPage()
        if not servers then
            print("[Hop] Failed to get server list; retry", tries)
            task.wait(API_RETRY_DELAY + math.random() * 0.25)
            continue
        end

        table.sort(servers, function(a, b)
            return (tonumber(a.playing) or 0) > (tonumber(b.playing) or 0)
        end)


        local state = getStateSnapshot()
        if not state then
            print("[Hop] Shared state busy; retrying page quickly")
            task.wait(0.15 + math.random() * 0.2)
            continue
        end

        local best = nil
        local bestScore = -math.huge

        for _, server in ipairs(servers) do
            local sid = tostring(server.id or "")
            local playing = tonumber(server.playing) or 0
            local maxP = tonumber(server.maxPlayers) or 0

            if sid ~= ""
                and sid ~= tostring(game.JobId)
                and maxP > 0
                and playing < maxP then

                local visited = type(state.visited[sid]) == "number"
                    and now() - state.visited[sid] < VISITED_TTL
                local reservation = state.reserved[sid]
                local reservations = 0

                if reservation
                    and reservation.owner ~= clientToken
                    and type(reservation.expires) == "number"
                    and reservation.expires > now() then
                    reservations = 1
                end

                local freeSlots = maxP - playing - reservations


                if not visited
                    and freeSlots >= 1 then

                    local score = playing
                    if force then
                        score += 0.001
                    end

                    if score > bestScore then
                        bestScore = score
                        best = {
                            id = sid,
                            playing = playing,
                            maxPlayers = maxP,
                            freeSlots = freeSlots
                        }
                    end
                end
            end
        end

        if best then

            if reserveServer(best.id) then
                lastTriedServer = best.id

                print(string.format(
                    "[Hop] Reserved %s (%d/%d, estimated free after reservations: %d)",
                    best.id,
                    best.playing,
                    best.maxPlayers,
                    best.freeSlots
                ))

                local success = teleportToServer(best.id)

                if success then

                    if not teleportFailed then
                        print("[Hop] Teleport pending/accepted; stopping further hops")
                        return true
                    end
                end

                if teleportFailed then
                    print("[Hop] Target rejected/full:", teleportFailureMessage or "unknown")
                else
                    print("[Hop] Teleport request could not be completed")
                end

                releaseReservation(best.id, true)
                lastTriedServer = nil
                teleportInProgress = false
                teleportFailed = false
                teleportFailureMessage = nil

                task.wait(SAME_TARGET_COOLDOWN + math.random() * 0.35)
                continue
            end

            task.wait(0.08 + math.random() * 0.15)
            continue
        end

        if cursor == "" then

            cursor = ""
            task.wait(0.35 + math.random() * 0.45)
        else
            task.wait(0.15 + math.random() * 0.25)
        end
    end


    if not teleportInProgress then
        teleportInProgress = true
        print("[Hop] No suitable reserved target found; fallback rejoin")

        local ok, err = pcall(function()
            TeleportService:Teleport(PlaceId, LP)
        end)

        if not ok then
            teleportInProgress = false
            getgenv().__FarmTeleporting = false
            print("[Hop] Fallback rejoin failed:", tostring(err))
        end
    end

    return false
end


local function getItemSpawns(itemName)
    local result = {
        Position = {},
        ProximityPrompt = {}
    }

    local folder =
        workspace:FindFirstChild("Item_Spawns")
        and workspace.Item_Spawns:FindFirstChild("Items")

    if not folder then
        return result
    end

    for _, item in pairs(folder:GetChildren()) do
        if item:FindFirstChild("MeshPart")
            and item:FindFirstChild("ProximityPrompt") then

            if item.ProximityPrompt.ObjectText == itemName
                and item.ProximityPrompt.MaxActivationDistance == 8 then

                table.insert(
                    result.ProximityPrompt,
                    item.ProximityPrompt
                )

                table.insert(
                    result.Position,
                    item.MeshPart.CFrame
                )
            end
        end
    end

    return result
end

local function collectItem(spawnData, index)
    local collected = false

    local timeout =
        (getgenv().waitUntilCollect or 0.5) + 4

    local char = LP.Character

    if char
        and char:FindFirstChild("SummonedStand")
        and char.SummonedStand.Value then

        pcall(function()
            local rf = char:FindFirstChild("RemoteFunction")

            if rf then
                rf:InvokeServer(
                    "ToggleStand",
                    "Toggle"
                )
            end
        end)
    end

    local conn

    conn = LP.Backpack.ChildAdded:Connect(function()
        collected = true

        if conn then
            conn:Disconnect()
        end
    end)

    task.spawn(function()
        while not collected do
            task.wait()

            pcall(function()
                local hrp =
                    LP.Character
                    and LP.Character:FindFirstChild("HumanoidRootPart")

                if hrp and spawnData.Position[index] then
                    hrp.CFrame =
                        spawnData.Position[index]
                        - Vector3.new(0, 8, 0)
                end
            end)
        end
    end)

    task.wait(
        getgenv().waitUntilCollect or 0.5
    )

    task.spawn(function()
        for _ = 1, 8 do
            pcall(function()
                if spawnData.ProximityPrompt[index] then
                    fireproximityprompt(
                        spawnData.ProximityPrompt[index]
                    )
                end
            end)

            task.wait(0.12)
        end
    end)

    task.spawn(function()
        task.wait(timeout)
        collected = true
    end)

    while not collected do
        task.wait()
    end

    if conn then
        conn:Disconnect()
    end
end

local lastItemSeen = tick()

local function farmLoop()
    print("[Farm] started")

    while true do
        local any = false

        for _, info in ipairs(items_to_farm) do
            local spawns = getItemSpawns(info.Name)

            if #spawns.Position > 0 then
                any = true
                lastItemSeen = tick()

                print(
                    "[Farm] Collecting:",
                    info.Name,
                    #spawns.Position
                )

                for i = 1, #spawns.Position do
                    collectItem(spawns, i)
                    task.wait(0.15)
                end
            end

            task.wait(0.05)
        end

        if any then
            lastItemSeen = tick()
            task.wait(0.2)
        else
            if getgenv().HopWhenNoItems
                and (tick() - lastItemSeen)
                    >= (getgenv().NoItemsTimeout or 5) then

                print(
                    "[Farm] No items for",
                    math.floor(tick() - lastItemSeen),
                    "s → hopping"
                )

                hopServer()

                task.wait(8)

                lastItemSeen = tick()
            else
                task.wait(0.5)
            end
        end
    end
end



