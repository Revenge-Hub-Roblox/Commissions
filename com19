local function findInventoryWeaponId(weaponName)
    if type(weaponName) ~= "string" then return nil end
    local target = string.lower(weaponName)
    local found = nil
    for _, key in ipairs({ "Inventory", "inventory", "InventoryItems", "Items" }) do
        local inv = getDataValue(key)
        if type(inv) == "table" then
            local function walk(t, depth)
                if depth > 6 or type(t) ~= "table" or found then return end
                local id = t._id or t.Identifier
                local nm = t.Name or t.Skin
                if type(id) == "string" and type(nm) == "string"
                    and string.lower(nm) == target then
                    found = id
                    return
                end
                for k, v in pairs(t) do
                    if type(v) == "table" and k ~= "_settings" then
                        walk(v, depth + 1)
                    end
                end
            end
            walk(inv, 0)
            if found then return found end
        end
    end
    return nil
end

local function getWeaponController(now)
    local char = LocalPlayer.Character
    attachCharacterWatch(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local tool = char and char:FindFirstChildOfClass("Tool")

    if not tool and bp and hum then
        local bpTool = bp:FindFirstChildOfClass("Tool")
        if bpTool then
            pcall(function() hum:EquipTool(bpTool) end)
            tool = char and char:FindFirstChildOfClass("Tool")
        end
    end

    local toolName = tool and tool.Name or nil
    local eqId, eqName = equippedIdentifier()

    if weaponCache then
        local wid = rawget(weaponCache, "Identifier")
        local wname = rawget(weaponCache, "Name")
        if eqId and wid and wid ~= eqId then
            resetWeaponCache("equipped mismatch (CurrentEquipped)")
        elseif toolName and not (wname == toolName or wid == toolName or (eqId and wid == eqId)) then
            resetWeaponCache("tool mismatch: cache=" .. tostring(wname or wid) .. " tool=" .. toolName)
        elseif not toolName and not eqId and (now - lastShotAt) > 1.5 then
            resetWeaponCache("no tool timeout")
        else
            return weaponCache
        end
    end

    if (now - lastWeaponScan) < 0.3 then return nil end
    lastWeaponScan = now

    local list = collectWeaponControllers()

    if (now - lastDebugAt) > 5 then
        lastDebugAt = now
        print(("[Frozent][SHOT][DEBUG] tool=%s equipped(id=%s,name=%s) candidates=[%s]"):format(
            tostring(toolName),
            tostring(eqId and string.sub(eqId, 1, 8) or nil), tostring(eqName),
            describeControllers(list)))
    end

    if eqId then
        for _, w in ipairs(list) do
            if rawget(w, "Identifier") == eqId then
                weaponCache = w
                return w
            end
        end
    end
    if toolName then
        for _, w in ipairs(list) do
            if rawget(w, "Name") == toolName or rawget(w, "Identifier") == toolName then
                weaponCache = w
                return w
            end
        end
    end
    if eqName then
        for _, w in ipairs(list) do
            if rawget(w, "Name") == eqName then
                weaponCache = w
                return w
            end
        end
    end
    local lookupName = eqName or toolName
    if lookupName then
        local invId = findInventoryWeaponId(lookupName)
        if invId then
            for _, w in ipairs(list) do
                if rawget(w, "Identifier") == invId then
                    weaponCache = w
                    return w
                end
            end
        end
    end
    if #list == 1 then
        weaponCache = list[1]
        return list[1]
    end
    if #list > 1 then
        for _, w in ipairs(list) do
            if not isBadController(w) and (rawget(w, "Rounds") or 0) > 0 then
                weaponCache = w
                return w
            end
        end
        for _, w in ipairs(list) do
            if not isBadController(w) then
                weaponCache = w
                return w
            end
        end
        tlog("WEAPON", 5, "all candidates blacklisted -> clearing blacklist")
        for k in pairs(badControllers) do badControllers[k] = nil end
        for _, w in ipairs(list) do
            if (rawget(w, "Rounds") or 0) > 0 then
                weaponCache = w
                return w
            end
        end
        weaponCache = list[1]
        return list[1]
    end
    return nil
end

ensureWeaponEquipped = function(weaponName)
    if type(weaponName) ~= "string" then return false end
    local _, eqName = equippedIdentifier()
    if eqName and string.find(string.lower(eqName), string.lower(weaponName), 1, true) then
        return true
    end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if hum and bp then
        local t = bp:FindFirstChild(weaponName)
        if t then
            pcall(function() hum:EquipTool(t) end)
            task.wait(0.4)
            local _, n2 = equippedIdentifier()
            if n2 and string.find(string.lower(n2), string.lower(weaponName), 1, true) then
                tlog("EQUIP", 1, "equipped via EquipTool:", weaponName)
                return true
            end
        end
    end
    local okVIM, VIM = pcall(game.GetService, game, "VirtualInputManager")
    if okVIM and VIM then
        local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }
        for _, key in ipairs(keys) do
            pcall(function()
                VIM:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                VIM:SendKeyEvent(false, key, false, game)
            end)
            task.wait(0.4)
            local _, n2 = equippedIdentifier()
            if n2 and string.find(string.lower(n2), string.lower(weaponName), 1, true) then
                tlog("EQUIP", 1, "equipped via key", key.Name, "->", weaponName)
                return true
            end
        end
    end
    tlog("EQUIP", 10, "не удалось переключиться на", weaponName)
    return false
end

local function getFireInterval(w)
    local props = w.Properties
    local candidates = {}
    if type(props) == "table" then
        local fm = rawget(props, "FireModes")
        if type(fm) == "table" then
            for _, modeName in ipairs({ "Primary", "Secondary" }) do
                local mode = rawget(fm, modeName)
                if type(mode) == "table" and type(mode.FireRate) == "number" and mode.FireRate > 0 then
                    table.insert(candidates, mode.FireRate)
                end
            end
        end
        local fr = rawget(props, "FireRate")
        if type(fr) == "number" and fr > 0 then
            table.insert(candidates, fr)
        end
    end
    local base = 0.12
    for _, c in ipairs(candidates) do
        if c > base then base = c end
    end
    local interval = math.max(base * (Environment.ParsaShotIntervalScale or 1.15), 0.11)
    return interval, base
end

local function manualShootPacket(w)
    if not shootWeaponPacket or type(shootWeaponPacket.Send) ~= "function" then
        if not warnedNoShootPath then
            warnedNoShootPath = true
            warn("[Frozent] ShootWeapon wrapper не найден — стрельба невозможна")
        end
        return
    end
    local rounds = w.Rounds
    if type(rounds) ~= "number" or rounds <= 0 then
        local reloadFn = resolveWeaponMethod(w, "reload")
        if reloadFn then pcall(reloadFn, w) end
        return
    end
    local bulletClass = rawget(w, "Bullet")
    if type(bulletClass) ~= "table" then return end
    local createFn = resolveWeaponMethod(bulletClass, "create")
    if not createFn then return end
    local props = w.Properties or {}
    local perShot = rawget(props, "BulletsPerShot") or 1
    local bullets = {}
    for _ = 1, perShot do
        local ok, b = pcall(createFn, bulletClass, rawget(props, "AimingOptions"), w.IsAiming)
        if ok and type(b) == "table" then
            local origin = b.Origin
            local hits = {}
            for _, h in ipairs(b.Hits or {}) do
                if type(h) == "table" and h.Instance then
                    hits[#hits + 1] = {
                        Distance = (h.Position - origin).Magnitude,
                        Instance = h.Instance,
                        Position = h.Position,
                        Normal = h.Normal,
                        Material = h.Material,
                        Exit = h.Exit,
                    }
                    origin = h.Position
                end
            end
            bullets[#bullets + 1] = { Direction = b.Direction, Origin = b.Origin, Hits = hits }
        end
    end
    if #bullets == 0 then return end
    w.ShotSeq = (w.ShotSeq or 0) + 1
    w.IsShooting = true
    w.Rounds = rounds - 1
    pcall(function() w.RechargeStartTime = workspace:GetServerTimeNow() end)
    pcall(function()
        shootWeaponPacket.Send({
            IsSniperScoped = w.IsSniperScoped or false,
            ShootingHand = w.ShootingHand,
            Identifier = w.Identifier,
            Seq = w.ShotSeq,
            Bullets = bullets,
        })
    end)
end

local function isAutomaticWeapon(w)
    local name = rawget(w, "Name")
    if name and Environment.ParsaAutoWeapons[name] == true then return true end
    local props = w.Properties
    if type(props) ~= "table" then return false end
    if props.Automatic == true then return true end
    local fm = rawget(props, "FireModes")
    if type(fm) == "table" then
        local prim = rawget(fm, "Primary")
        if type(prim) == "table" and (prim.Automatic == true or prim.FireMode == "Auto" or prim.Mode == "Auto") then
            return true
        end
        if type(prim) == "string" then
            local pl = string.lower(prim)
            if pl == "auto" or pl == "automatic" then return true end
        end
    end
    return false
end

local function stopAutoFire()
    if autoFireActive then
        autoFireActive = false
        local w = weaponCache
        if w then
            pcall(function() w.IsFireHeld = false end)
        end
        tlog("SHOT", 1, "auto fire stopped (IsFireHeld=false)")
    end
end

local function ensureAmmo(w, now)
    local rounds = rawget(w, "Rounds")
    if type(rounds) ~= "number" then return true end
    if prevRoundsValue == 0 and rounds > 0 then
        prevRoundsValue = rounds
        stats.reloadRebinds += 1
        tlog("SHOT", 1, "reload COMPLETED -> weapon rebind + bullet rescan (rebinds=" .. stats.reloadRebinds .. ")")
        reloadingUntil = 0
        resetWeaponCache("reload completed")
        if forceScanBullets then forceScanBullets() end
        return false
    end
    prevRoundsValue = rounds
    if rounds > 0 then
        reloadStreak = 0
        return true
    end
    if now < reloadingUntil then
        if autoFireActive and weaponCache then
            pcall(function() weaponCache.IsFireHeld = false end)
        end
        return false
    end
    if now - reloadRequestedAt > 1 then
        reloadRequestedAt = now
        reloadStreak += 1
        stats.reloads += 1
        reloadingUntil = now + (tonumber(Environment.ParsaReloadWait) or 2.3)
        local reloadFn = resolveWeaponMethod(w, "reload")
        if reloadFn then
            pcall(reloadFn, w)
            tlog("SHOT", 1, "ammo empty -> reload(), fire paused")
        end
        if reloadStreak >= 3 then
            reloadStreak = 0
            stats.forcedResets += 1
            markBadController(w)
            resetWeaponCache("reload stuck (3 attempts)")
        end
    end
    return false
end

local function remoteShoot(now)
    local w = getWeaponController(now)
    if not w then
        stopAutoFire()
        tlog("SHOT", 5, "weapon controller NOT found")
        return
    end
    if isAutomaticWeapon(w) then
        if not autoFireActive then
            autoFireActive = true
            tlog("SHOT", 2, "AUTO weapon:", tostring(rawget(w, "Name")), "-> hold-fire mode (every frame)")
        end
        if not ensureAmmo(w, now) then return end
        pcall(function() w.IsFireHeld = true end)
        local shootFn = resolveWeaponMethod(w, "shoot")
        if shootFn then
            stats.shotsRequested += 1
            pcall(shootFn, w, false)
        else
            if (now - lastShotAt) >= 0.05 then
                lastShotAt = now
                task.spawn(manualShootPacket, w)
            end
        end
        return
    end
    stopAutoFire()
    local interval, baseRate = getFireInterval(w)
    if (now - lastShotAt) < interval then return end
    if not ensureAmmo(w, now) then return end
    lastShotAt = now
    stats.shotsRequested += 1
    tlog("SHOT", 5, ("fire SEMI weapon=%s interval=%.3f base=%.3f"):format(
        tostring(rawget(w, "Name") or rawget(w, "Identifier")), interval, baseRate))
    local shootFn = resolveWeaponMethod(w, "shoot")
    if shootFn then
        task.spawn(function()
            pcall(shootFn, w, false)
        end)
    else
        task.spawn(manualShootPacket, w)
    end
end


local payloadRayParams = RaycastParams.new()
payloadRayParams.FilterType = Enum.RaycastFilterType.Exclude
payloadRayParams.IgnoreWater = true

local function buildHitChain(origin, targetPart)
    local char = LocalPlayer.Character
    payloadRayParams.FilterDescendantsInstances = char and { char } or {}
    local hits = {}
    local current = origin
    local maxSegments = 4
    for _ = 1, maxSegments do
        local targetPos = targetPart.Position
        local delta = targetPos - current
        local dist = delta.Magnitude
        if dist < 0.001 then break end
        local dir = delta.Unit
        local result = Workspace:Raycast(current, dir * dist, payloadRayParams)
        if not result then
            hits[#hits + 1] = {
                Instance = targetPart,
                Position = targetPos,
                Normal = -dir,
                Material = (typeof(targetPart.Material) == "EnumItem") and targetPart.Material.Name or "Air",
                Distance = dist,
                Exit = false,
            }
            return hits
        end
        local targetChar = targetPart:FindFirstAncestorOfClass("Model")
        local hitChar = result.Instance and result.Instance:FindFirstAncestorOfClass("Model")
        if hitChar == targetChar then
            hits[#hits + 1] = {
                Instance = result.Instance,
                Position = result.Position,
                Normal = result.Normal or -dir,
                Material = result.Material and result.Material.Name or "Air",
                Distance = (result.Position - origin).Magnitude,
                Exit = false,
            }
            return hits
        end
        hits[#hits + 1] = {
            Instance = result.Instance,
            Position = result.Position,
            Normal = result.Normal or -dir,
            Material = result.Material and result.Material.Name or "Air",
            Distance = (result.Position - origin).Magnitude,
            Exit = false,
        }
        current = result.Position + dir * 0.1
    end
    local targetPos = targetPart.Position
    local delta = targetPos - current
    local dist = delta.Magnitude
    if dist > 0.001 then
        local dir = delta.Unit
        hits[#hits + 1] = {
            Instance = targetPart,
            Position = targetPos,
            Normal = -dir,
            Material = (typeof(targetPart.Material) == "EnumItem") and targetPart.Material.Name or "Air",
            Distance = (targetPos - origin).Magnitude,
            Exit = false,
        }
    end
    return hits
end

local lastUnhookRescanAt = 0
local function redirectPayloadBullets(payload)
    local targetPart = Environment.ParsaSilentTarget
    if not targetPart then
        local found = scanForEnemyTarget()
        if found then
            targetPart = found.Part
            Environment.ParsaSilentTarget = found.Part
            Environment.ParsaCurrentTargetPlayer = found.Player
            Environment.ParsaSilentTargetInfo = found
        end
    end
    if not targetPart or not isTargetValid(targetPart) then return end
    local targetChar = targetPart:FindFirstAncestorOfClass("Model")
    local targetMaterial = "Air"
    pcall(function() targetMaterial = targetPart.Material.Name end)
    local rayHooked = (os.clock() - lastRayRetargetAt) < 0.06

    local bullets = payload.Bullets
    for i = 1, #bullets do
        local bullet = bullets[i]
        if type(bullet) == "table" and typeof(bullet.Origin) == "Vector3" and type(bullet.Hits) == "table" then
            local origin = bullet.Origin
            local lastIdx, lastHit = nil, nil
            for idx, h in pairs(bullet.Hits) do
                if type(h) == "table" and (lastIdx == nil or idx > lastIdx) then
                    lastIdx, lastHit = idx, h
                end
            end
            local alreadyTarget = false
            if lastHit and typeof(lastHit.Instance) == "Instance" then
                local hc = lastHit.Instance:FindFirstAncestorOfClass("Model")
                if hc == targetChar then alreadyTarget = true end
            end
            if alreadyTarget then
                stats.sendClean += 1
                if typeof(lastHit.Position) == "Vector3" then
                    local d = lastHit.Position - origin
                    if d.Magnitude > 0.001 then
                        bullet.Direction = d.Unit
                    end
                end
            else
                -- [FINAL FIX] пуля не в цели: ВСЕГДА строим собственную цепочку
                -- рейкастом Origin->цель (надёжнее ретаргета: покрывает нехукнутые
                -- классы, переходные состояния reload, ленивые Bullet-классы)
                local delta = targetPart.Position - origin
                local length = delta.Magnitude
                if length > 0.001 then
                    local chain = buildHitChain(origin, targetPart)
                    if #chain > 0 then
                        bullet.Hits = chain
                        local last = chain[#chain]
                        if typeof(last.Position) == "Vector3" then
                            local d = last.Position - origin
                            if d.Magnitude > 0.001 then
                                bullet.Direction = d.Unit
                            end
                        end
                        if rayHooked then
                            stats.sendRetarget += 1
                        else
                            stats.sendChainUnhooked += 1
                        end
                    end
                end
                local now = os.clock()
                if not rayHooked and now - lastUnhookRescanAt > 1 then
                    lastUnhookRescanAt = now
                    tlog("SHOT", 2, "UNHOOKED bullet -> chain rebuild + force rescan")
                    task.spawn(function()
                        if forceScanBullets then forceScanBullets() end
                    end)
                end
            end
        end
    end
end

local function hookShootSend()
    if shootSendHook then return end
    if not shootWeaponPacket or type(shootWeaponPacket.Send) ~= "function" then return end
    local wrapper = shootWeaponPacket
    local orig = wrapper.Send
    wrapper.Send = function(payload, ...)
        if Runtime.Alive
            and Environment.ParsaAutofarmEnabled == true
            and type(payload) == "table"
            and type(payload.Bullets) == "table"
            and #payload.Bullets > 0 then
            stats.bulletsSent += #payload.Bullets
            pcall(redirectPayloadBullets, payload)
        end
        return orig(payload, ...)
    end
    shootSendHook = { wrapper = wrapper, orig = orig }
    print("[Frozent] ShootWeapon.Send hooked (always-rebuild fallback)")
end

