local function findPacketWrapperByRemote(remoteEvent)
    if not remoteEvent then return nil end
    if typeof(getgc) ~= "function" then return nil end
    local found
    pcall(function()
        for _, obj in next, getgc(true) do
            if type(obj) == "table" then
                local sendFn = rawget(obj, "Send")
                if type(sendFn) == "function" and type(rawget(obj, "Listen")) == "function" then
                    if typeof(getupvalues) == "function" then
                        local ok, ups = pcall(getupvalues, sendFn)
                        if ok and type(ups) == "table" then
                            for _, uv in ipairs(ups) do
                                local hit = false
                                if uv == remoteEvent then
                                    hit = true
                                elseif type(uv) == "table" then
                                    for _, v in pairs(uv) do
                                        if v == remoteEvent then hit = true break end
                                    end
                                end
                                if hit then
                                    found = obj
                                    break
                                end
                            end
                        end
                    end
                end
            end
            if found then break end
        end
    end)
    return found
end

local function cacheAddItem(item)
    if type(item) ~= "table" then return end
    local id = item._id or item.Identifier
    if type(id) ~= "string" then return end
    local displayName = item.Skin or item.Name
    if type(displayName) ~= "string" or #displayName == 0 then return end
    local t = item.Type
    local looksCase = (type(t) == "string" and string.lower(t) == "case")
    if not looksCase then
        looksCase = isCaseName(displayName)
    end
    if not looksCase then return end
    local rinfo = resolveCaseInfo(displayName)
    caseInstanceCache[id] = {
        nameLower = string.lower(displayName),
        caseIdLower = rinfo and string.lower(rinfo.CaseId) or nil,
    }
end

local function cacheRemoveIds(ids)
    if type(ids) ~= "table" then return end
    for _, id in ipairs(ids) do
        if type(id) == "string" then
            caseInstanceCache[id] = nil
        elseif type(id) == "table" and type(id._id) == "string" then
            caseInstanceCache[id._id] = nil
        end
    end
end

local function hookDataController()
    if deltaHook or not dataController then return end
    if type(dataController.ApplyInventoryDelta) ~= "function" then return end
    local orig = dataController.ApplyInventoryDelta
    local wrapper = function(a, b, c, d, ...)
        pcall(function()
            local args = { a, b, c, d }
            local items, deletedIds
            for i = 1, 4 do
                local v = args[i]
                if type(v) == "table" then
                    local first = v[1]
                    if type(first) == "table" then
                        if items == nil then items = v end
                    elseif type(first) == "string" then
                        if deletedIds == nil then deletedIds = v end
                    end
                end
            end
            if items then
                for _, it in ipairs(items) do cacheAddItem(it) end
            end
            if deletedIds then cacheRemoveIds(deletedIds) end
        end)
        return orig(a, b, c, d, ...)
    end
    dataController.ApplyInventoryDelta = wrapper
    deltaHook = { module = dataController, orig = orig }
    print("[Frozent] ApplyInventoryDelta hooked")
    dumpDataSources()
end

local function collectCaseIdentifiers(caseName, want)
    want = want or 1
    local rinfo = resolveCaseInfo(caseName)
    if not rinfo then
        print("[Frozent] collectIds: unknown case '" .. tostring(caseName) .. "'")
        return nil
    end
    local targetIdLower = string.lower(rinfo.CaseId)
    local nameLower = string.lower(caseName)

    local ids = {}
    for id, meta in pairs(caseInstanceCache) do
        if meta.caseIdLower == targetIdLower or meta.nameLower == nameLower then
            ids[#ids + 1] = id
            if #ids >= want then break end
        end
    end
    if #ids > 0 then return ids end

    if collectIdsFn then
        local ok, res = pcall(collectIdsFn, caseName, want)
        if ok and type(res) == "table" and #res > 0 then
            local out = {}
            for i = 1, math.min(want, #res) do out[i] = res[i] end
            return out
        end
    end

    do
        for _, key in ipairs({ "Inventory", "inventory", "InventoryItems", "Items" }) do
            local inv = getDataValue(key)
            if type(inv) == "table" then
                local found = {}
                local function checkItem(t)
                    local id = t._id or t.Identifier
                    if type(id) ~= "string" then return end
                    local displayName = t.Skin or t.Name
                    if type(displayName) ~= "string" then return end
                    local tType = t.Type
                    local looksCase = (type(tType) == "string" and string.lower(tType) == "case")
                    if not looksCase then looksCase = isCaseName(displayName) end
                    if not looksCase then return end
                    if string.lower(displayName) == nameLower then
                        found[#found + 1] = id
                        return
                    end
                    local ri = resolveCaseInfo(displayName)
                    if ri and string.lower(ri.CaseId) == targetIdLower then
                        found[#found + 1] = id
                    end
                end
                local function walk(t, depth)
                    if depth > 6 or type(t) ~= "table" then return end
                    checkItem(t)
                    for k, v in pairs(t) do
                        if type(v) == "table" and k ~= "_settings" then
                            walk(v, depth + 1)
                        end
                    end
                end
                walk(inv, 0)
                if #found > 0 then
                    local out = {}
                    for i = 1, math.min(want, #found) do out[i] = found[i] end
                    return out
                end
            end
        end
    end

    print("[Frozent] collectIds: нет экземпляров '" .. caseName .. "' в инвентаре")
    return nil
end

local PURCHASE_CASE_HEADER = { 1, 40, 181, 47, 253, 32, 54, 177, 1, 0 }
local function buildPurchaseCasePacketRaw(caseId)
    local bytes = {}
    for _, v in ipairs(PURCHASE_CASE_HEADER) do bytes[#bytes + 1] = v end
    bytes[#bytes + 1] = 6
    bytes[#bytes + 1] = 2; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0
    bytes[#bytes + 1] = 4
    bytes[#bytes + 1] = 6; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0
    for i = 1, 6 do bytes[#bytes + 1] = string.byte("Amount", i) end
    bytes[#bytes + 1] = 3
    for _, v in ipairs({ 0, 0, 0, 0, 0, 0, 240, 63 }) do bytes[#bytes + 1] = v end
    bytes[#bytes + 1] = 4
    bytes[#bytes + 1] = 6; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0
    for i = 1, 6 do bytes[#bytes + 1] = string.byte("CaseId", i) end
    bytes[#bytes + 1] = 4
    bytes[#bytes + 1] = #caseId; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0; bytes[#bytes + 1] = 0
    for i = 1, #caseId do bytes[#bytes + 1] = string.byte(caseId, i) end
    return bytesToBuffer(bytes)
end

