                        caseInfo[id] = { CaseId = id, Price = price, CaseType = rawget(obj, "caseType") }
                        changed = true
                    end
                end
            end
        end)
        if purchaseCasePacket == nil and purchaseRemote then
            purchaseCasePacket = findPacketWrapperByRemote(purchaseRemote)
            if purchaseCasePacket then print("[Frozent] PurchaseCase wrapper (by upvalue)") end
        end
        if openCasePacket == nil and openRemote then
            openCasePacket = findPacketWrapperByRemote(openRemote)
            if openCasePacket then print("[Frozent] OpenCase wrapper (by upvalue)") end
        end
        if openConsolePacket == nil and consoleRemote then
            openConsolePacket = findPacketWrapperByRemote(consoleRemote)
        end
        if shootWeaponPacket == nil and shootRemote then
            shootWeaponPacket = findPacketWrapperByRemote(shootRemote)
            if shootWeaponPacket then print("[Frozent] ShootWeapon wrapper (by upvalue)") end
        end
        if buyMenuPacket == nil and buyRemote then
            buyMenuPacket = findPacketWrapperByRemote(buyRemote)
            if buyMenuPacket then print("[Frozent] BuyMenuPurchase wrapper (by upvalue)") end
        end
        hookDataController()
        if changed then refreshCaseDropdowns() end
        if purchaseCasePacket and openCasePacket and dataController and next(caseInfo)
            and shootWeaponPacket and buyMenuPacket then break end
        task.wait(2)
    end
    if next(caseInfo) then
        print("[Frozent] discovered " .. tostring(#caseNamesList()) .. " case(s)")
    else
        warn("[Frozent] no cases discovered — заполните Environment.ParsaCasePrices вручную")
    end
end)


task.spawn(function()
    local function initialScan()
        for _, key in ipairs({ "Inventory", "inventory", "InventoryItems", "Items" }) do
            local inv = getDataValue(key)
            if type(inv) == "table" then
                local function walk(t, depth)
                    if depth > 6 or type(t) ~= "table" then return end
                    cacheAddItem(t)
                    for k, v in pairs(t) do
                        if type(v) == "table" and k ~= "_settings" then
                            walk(v, depth + 1)
                        end
                    end
                end
                walk(inv, 0)
            end
        end
    end

    local function listenNewItems(group, name)
        local rs = ReplicatedStorage:FindFirstChild("NetworkRemotes")
        local g = rs and rs:FindFirstChild(group)
        local remote = g and g:FindFirstChild(name)
        if not remote then return end
        local ok, conn = pcall(function()
            return remote.OnClientEvent:Connect(function(payload)
                if type(payload) ~= "table" then return end
                if type(payload.Items) == "table" then
                    for _, it in ipairs(payload.Items) do cacheAddItem(it) end
                end
                if type(payload.DeletedItemIds) == "table" then
                    cacheRemoveIds(payload.DeletedItemIds)
                end
            end)
        end)
        if ok and conn then table.insert(caseEventConns, conn) end
    end
    listenNewItems("Store", "NewInventoryItem")
    listenNewItems("Inventory", "NewInventoryItem")

    local openedRemote = getStoreRemote("CaseOpened")
    if openedRemote then
        local ok, conn = pcall(function()
            return openedRemote.OnClientEvent:Connect(function(payload)
                if type(payload) ~= "table" then return end
                if type(payload.InventoryItems) == "table" and #payload.InventoryItems > 0 then
                    local names = {}
                    for _, item in ipairs(payload.InventoryItems) do
                        table.insert(names, tostring(item and (item.Skin or item.Name)))
                        cacheAddItem(item)
                    end
                    print("[Frozent] CaseOpened: " .. table.concat(names, ", "))
                end
                if type(payload.DeletedCaseIds) == "table" then
                    cacheRemoveIds(payload.DeletedCaseIds)
                end
                if type(payload.CaseIdentifier) == "string" then
                    task.defer(function()
                        if seqFinishedPacket then
                            pcall(function()
                                seqFinishedPacket.Send({ CaseIdentifier = payload.CaseIdentifier })
                            end)
                        end
                    end)
                end
            end)
        end)
        if ok and conn then table.insert(caseEventConns, conn) end
    end

    local deniedRemote = getStoreRemote("CaseOpenDenied")
    if deniedRemote then
        local ok, conn = pcall(function()
            return deniedRemote.OnClientEvent:Connect(function(payload)
                local reason = type(payload) == "table" and tostring(payload.Reason) or "?"
                local retry = type(payload) == "table" and tostring(payload.RetryAfterMs) or "?"
                warn("[Frozent] CaseOpenDenied: reason=" .. reason .. " retryAfter=" .. retry .. "ms")
            end)
        end)
        if ok and conn then table.insert(caseEventConns, conn) end
    end

    task.spawn(function()
        local remote = getStoreRemote("CaseOpenSequenceFinished")
        if remote then
            for _ = 1, 30 do
                if not Runtime.Alive then return end
                seqFinishedPacket = findPacketWrapperByRemote(remote)
                if seqFinishedPacket then break end
                task.wait(2)
            end
        end
    end)

    task.wait(5)
    initialScan()
    while Runtime.Alive do
        task.wait(15)
        local n = 0
        for _ in pairs(caseInstanceCache) do n += 1 end
        if n == 0 then initialScan() end
    end
end)


