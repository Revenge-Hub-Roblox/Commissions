local SELECT_TEAM_HEADER = { 1, 40, 181, 47, 253, 32, 23, 185, 0, 0, 4 }
local PRESSED_PLAY_PACKET = bytesToBuffer({ 1, 40, 181, 47, 253, 32, 1, 9, 0, 0, 0 })
local SELECT_DM_PACKET = bytesToBuffer({
    1, 40, 181, 47, 253, 32, 15, 121, 0, 0, 4, 10, 0, 0, 0,
    68, 101, 97, 116, 104, 109, 97, 116, 99, 104
})
local teamRemote, playRemote, selectModeRemote

local function isInDeathmatch()
    local ok1, a1 = pcall(Workspace.GetAttribute, Workspace, "ServerGamemode")
    local ok2, a2 = pcall(Workspace.GetAttribute, Workspace, "Gamemode")
    return (ok1 and a1 == "Deathmatch") or (ok2 and a2 == "Deathmatch")
end
Environment.ParsaIsDeathmatch = isInDeathmatch

local function buildSelectTeamPacket(teamName)
    local bytes = {}
    for _, v in ipairs(SELECT_TEAM_HEADER) do bytes[#bytes + 1] = v end
    bytes[#bytes + 1] = #teamName
    bytes[#bytes + 1] = 0
    bytes[#bytes + 1] = 0
    bytes[#bytes + 1] = 0
    for i = 1, #teamName do bytes[#bytes + 1] = string.byte(teamName, i) end
    return bytesToBuffer(bytes)
end

local function selectDeathmatchIfNeeded()
    if isInDeathmatch() then
        tlog("DM", 10, "уже в Deathmatch — SelectGamemode не отправляем")
        return true
    end
    local sent = false
    if selectModeRemote then
        sent = pcall(function() selectModeRemote:FireServer(SELECT_DM_PACKET, {}) end)
        if sent then
            tlog("DM", 1, "SelectGamemode -> Deathmatch sent (exact packet)")
        end
    end
    if not sent then
        local dmBtn = findButtonByPattern("deathmatch")
        if dmBtn then
            clickGuiButton(dmBtn)
            task.wait(1.2)
            sent = true
            tlog("DM", 1, "Deathmatch sent via GUI click")
        else
            warn("[Frozent] кнопка Deathmatch в меню не найдена")
        end
    end
    return sent
end

local function pressPlaySequence()
    if playRemote then
