local lastWeaponBuyAttempt = 0
local weaponBuyFails = 0
local lastBuyDebugAt = 0
local function tryBuyTeamWeapon()
    if not Runtime.Alive then return end
    local team = get_player_team(LocalPlayer)
    local cfg = TEAM_WEAPONS[team]
    if not cfg then
        tlog("BUY", 15, "no team:", tostring(team))
        return
    end
    if hasWeapon(cfg.Name) then
        weaponBuyFails = 0
        return
    end
    local ch = LocalPlayer.Character
    if not ch or ch:GetAttribute("Dead") then return end
    local price = Environment.ParsaWeaponPrices and Environment.ParsaWeaponPrices[cfg.Name] or 1250
    local money, src = getMatchMoney()
    local now = os.clock()
    if (now - lastBuyDebugAt) > 10 then
        lastBuyDebugAt = now
        print(("[Frozent][BUY] want=%s team=%s money=%s(src=%s) price=%s exactPacket=%s wrapper=%s"):format(
            cfg.Name, tostring(team), tostring(money), tostring(src), tostring(price),
            tostring(cfg.Packet ~= nil), tostring(buyMenuPacket ~= nil)))
    end
    if not money or money < price then return end
    local retryInterval = tonumber(Environment.ParsaBuyRetryInterval) or 2.5
    local failBackoff = tonumber(Environment.ParsaBuyFailBackoff) or 20
    local cooldown = (weaponBuyFails >= 3) and failBackoff or retryInterval
    if now - lastWeaponBuyAttempt < cooldown then return end
    lastWeaponBuyAttempt = now

    local sent = false
    if cfg.Packet then
        local remote = getBuyMenuRemote()
        if remote then
            sent = pcall(function() remote:FireServer(cfg.Packet, {}) end)
            if sent then tlog("BUY", 1, "sent EXACT packet:", cfg.Name) end
        end
    end
    if not sent and buyMenuPacket and type(buyMenuPacket.Send) == "function" then
        sent = pcall(function()
            buyMenuPacket.Send({ Equipment = true, Path = cfg.Path, Name = cfg.Name })
        end)
        if sent then tlog("BUY", 1, "sent via wrapper:", cfg.Name) end
    end
    if not sent and buyTemplateBytes then
        local remote = getBuyMenuRemote()
        if remote then
            sent = pcall(function() remote:FireServer(bytesToBuffer(buyTemplateBytes), {}) end)
            if sent then tlog("BUY", 1, "sent via template replay") end
        end
    end

    if sent then
        task.delay(retryInterval + 1.5, function()
            if not Runtime.Alive then return end
            if hasWeapon(cfg.Name) then
                weaponBuyFails = 0
                print("[Frozent][BUY] SUCCESS: " .. cfg.Name .. " в инвентаре")
                if Environment.ParsaAutoEquipAfterBuy then
                    task.spawn(function()
                        ensureWeaponEquipped(cfg.Name)
                    end)
                end
            else
                weaponBuyFails += 1
                warn("[Frozent][BUY] отправлено, но " .. cfg.Name
                    .. " не появился (попытка #" .. weaponBuyFails .. ")")
            end
        end)
    else
        warn("[Frozent][BUY] не удалось отправить покупку " .. cfg.Name)
    end
end

