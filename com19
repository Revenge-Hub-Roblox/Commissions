        for _, d in ipairs(PlayerGui:GetDescendants()) do
            if d:IsA("GuiButton") then
                local txt
                pcall(function() txt = d.Text end)
                local match = nameSet[d.Name] == true
                if not match and txt ~= nil and textSet ~= nil then
                    match = textSet[string.lower(txt)] == true
                end
                if match and d.Visible and d.AbsoluteSize.X > 1 then
                    found = d
                    break
                end
            end
        end
    end)
    return found
end

