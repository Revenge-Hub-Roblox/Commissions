local badControllers = {}
setmetatable(badControllers, { __mode = "k" })
local BAD_TTL = 30

local function markBadController(w)
    if w then
        badControllers[w] = os.clock() + BAD_TTL
        tlog("WEAPON", 1, "controller marked bad, ttl=" .. BAD_TTL .. "s")
    end
end

local function isBadController(w)
    local exp = badControllers[w]
    if not exp then return false end
    if os.clock() > exp then
        badControllers[w] = nil
        return false
    end
    return true
end

local function resetWeaponCache(reason)
    if weaponCache ~= nil then
        tlog("WEAPON", 1, "cache reset:", reason)
    end
    if autoFireActive and weaponCache then
        pcall(function() weaponCache.IsFireHeld = false end)
    end
    autoFireActive = false
    weaponCache = nil
end

local function attachCharacterWatch(char)
    if watchedChar == char then return end
    for _, c in ipairs(watchConns) do pcall(function() c:Disconnect() end) end
    watchConns = {}
    watchedChar = char
    if not char then return end
    table.insert(watchConns, char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then resetWeaponCache("tool added: " .. child.Name) end
    end))
    table.insert(watchConns, char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then resetWeaponCache("tool removed: " .. child.Name) end
    end))
end

local function resolveWeaponMethod(t, name)
    local v = rawget(t, name)
    if type(v) == "function" then return v end
    local mt = getmetatable(t)
    local depth = 0
    while type(mt) == "table" and depth < 3 do
        local idx = rawget(mt, "__index")
        if type(idx) == "function" then
            local ok, r = pcall(idx, t, name)
            if ok and type(r) == "function" then return r end
            break
        elseif type(idx) == "table" then
            v = rawget(idx, name)
            if type(v) == "function" then return v end
            mt = getmetatable(idx)
            depth += 1
        else
            break
        end
    end
    return nil
end

local function collectWeaponControllers()
    local list = {}
    if typeof(getgc) ~= "function" then return list end
    pcall(function()
        for _, obj in next, getgc(true) do
            if type(obj) == "table" then
                if type(rawget(obj, "Identifier")) == "string"
                    and type(rawget(obj, "Properties")) == "table"
                    and type(rawget(obj, "Rounds")) == "number"
                    and type(rawget(obj, "IsShooting")) == "boolean"
                    and rawget(obj, "ShotSeq") ~= nil
                    and rawget(obj, "ShootingHand") ~= nil then
                    table.insert(list, obj)
                end
            end
        end
    end)
    return list
end

local function describeControllers(list)
    local parts = {}
    for i, w in ipairs(list) do
        parts[#parts + 1] = ("%d:%s/%s(r=%s%s)"):format(i,
            tostring(rawget(w, "Name")),
            string.sub(tostring(rawget(w, "Identifier")), 1, 8),
            tostring(rawget(w, "Rounds")),
            isBadController(w) and ",BAD" or "")
    end
    return table.concat(parts, " | ")
end

