local function resolveCaseInfo(name)
    if type(name) ~= "string" or #name == 0 then return nil end
    local info = caseInfo[name]
    if info and info.CaseId then
        return { CaseId = info.CaseId, CaseType = info.CaseType }
    end
    if casesModule and type(casesModule.GetCaseByName) == "function" then
        local ok, c = pcall(casesModule.GetCaseByName, name)
        if ok and type(c) == "table" and type(c.caseId) == "string" then
            caseInfo[c.caseId] = { CaseId = c.caseId, Price = c.price, CaseType = c.caseType }
            caseInfo[name] = caseInfo[c.caseId]
            return { CaseId = c.caseId, CaseType = c.caseType }
        end
    end
    if string.find(name, "_", 1, true) then
        return { CaseId = name, CaseType = nil }
    end
    return nil
end

