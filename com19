local rejoining = false
local lastRejoinAt = 0
local function rejoinIfNeeded()
    if not Runtime.Alive then return end
    if not Environment.ParsaAutoJoinDeathmatch then return end
    if rejoining then return end
    if not playRemote then return end
    local now = os.clock()
    if now - lastRejoinAt < 4 then return end
    local playBtn = findMenuButton({ Play = true }, { play = true })
    if not playBtn then return end
    lastRejoinAt = now
    rejoining = true
    print("[Frozent] REJOIN: мы в меню (intermission/лобби) -> команда + DM + Play")
    stopAutoFire()
    resetWeaponCache("back to lobby")
    local myTeam = get_player_team(LocalPlayer)
    if myTeam ~= "Terrorists" and myTeam ~= "Counter-Terrorists" and teamRemote then
        teamRemote:FireServer(buildSelectTeamPacket(Environment.ParsaTeam), {})
        local t0 = os.clock()
        repeat
            task.wait(0.15)
            myTeam = get_player_team(LocalPlayer)
        until (myTeam == "Terrorists" or myTeam == "Counter-Terrorists") or os.clock() - t0 > 6
        if myTeam == "Terrorists" or myTeam == "Counter-Terrorists" then
            tlog("REJOIN", 1, "команда выбрана:", myTeam)
        else
            warn("[Frozent][REJOIN] команда не применилась за 6с")
        end
    end
    task.wait(0.3)
    selectDeathmatchIfNeeded()
    task.wait(0.3)
    pressPlaySequence()
    task.wait(2)
    tryBuyTeamWeapon()
    rejoining = false
end
