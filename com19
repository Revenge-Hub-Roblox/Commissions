local dataModuleCache = nil
local function getDataModule()
    if dataModuleCache ~= nil then
        return dataModuleCache or nil
    end
    local ok, mod = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("DataController"))
    end)
    if ok and type(mod) == "table" then
        dataModuleCache = mod
        return mod
    end
    dataModuleCache = false
    return nil
end

local function findPlayersDataTable()
    local mods = {}
    local mod = getDataModule()
    if mod then table.insert(mods, mod) end
    if dataController then table.insert(mods, dataController) end
    for _, m in ipairs(mods) do
        if type(m.Get) == "function" and typeof(getupvalues) == "function" then
            local ok, ups = pcall(getupvalues, m.Get)
            if ok and type(ups) == "table" then
                for _, uv in ipairs(ups) do
                    if type(uv) == "table" and type(uv[LocalPlayer]) == "table" then
                        return uv[LocalPlayer]
                    end
                end
            end
        end
    end
    return nil
end

local function getDataValue(key)
    local candidates = {}
    local mod = getDataModule()
    if mod then table.insert(candidates, mod) end
    if dataController then table.insert(candidates, dataController) end
    for _, m in ipairs(candidates) do
        if type(m.Get) == "function" then
            local ok, v = pcall(m.Get, LocalPlayer, key)
            if ok and v ~= nil then return v end
        end
    end
    local data = findPlayersDataTable()
    if type(data) == "table" then
        return data[key]
    end
    return nil
end

local function getCredits()
    local v = getDataValue("Credits")
    if type(v) == "number" then return v end
    local data = findPlayersDataTable()
    if data and type(data.Credits) == "number" then return data.Credits end
    return getBalance(SILVER_NAMES)
end

local function getMatchMoney()
    for _, key in ipairs(MONEY_NAMES) do
        local v = getDataValue(key)
        if type(v) == "number" then return v, key end
    end
    return getBalance(MONEY_NAMES), "attr/leaderstats"
end

