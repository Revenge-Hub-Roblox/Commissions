local function same_team(a, b)
    if a == nil or b == nil then return false end
    if a == b then return true end
    local an = typeof(a) == "Instance" and a.Name or tostring(a)
    local bn = typeof(b) == "Instance" and b.Name or tostring(b)
    return an == bn
end

local function partFor(character)
    return character:FindFirstChild(HIT_PART)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
end

local function scanForEnemyTarget()
    local myTeam = currentLocalTeam or get_player_team(LocalPlayer)
    if myTeam == nil or myTeam == "Spectators" then return nil end
    local camPos = Camera and Camera.CFrame and Camera.CFrame.Position
    if typeof(camPos) ~= "Vector3" then return nil end
    local best, bestDist = nil, math.huge
    local okCount, skipCount = 0, 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = get_player_team(player)
            if team ~= nil and team ~= "Spectators" and not same_team(team, myTeam) then
                local character = player.Character
                local ok, reason = isCharacterTargetable(character)
                if ok then
                    local part = partFor(character)
                    if part then
                        local dist = (part.Position - camPos).Magnitude
                        if dist <= MAX_DISTANCE and dist < bestDist then
                            bestDist = dist
                            best = { Player = player, Part = part, Distance = dist }
                        end
                    end
                    okCount += 1
                else
                    skipCount += 1
                end
            end
        end
    end
    stats.scanOK = okCount
    stats.scanSkipped = skipCount
    return best
end

local silentNextScan = 0
local function updateSilentTarget(now)
    if Environment.ParsaAutofarmEnabled ~= true or not LocalPlayer.Character then
        Environment.ParsaSilentTarget = nil
        Environment.ParsaCurrentTargetPlayer = nil
        Environment.ParsaSilentTargetInfo = nil
        return
    end
    if now < silentNextScan then return end
    silentNextScan = now + 0.025
    local prevPlayer = Environment.ParsaCurrentTargetPlayer
    if prevPlayer then
        if prevPlayer.Parent == nil then
            Environment.ParsaCurrentTargetPlayer = nil
            Environment.ParsaSilentTarget = nil
            Environment.ParsaSilentTargetInfo = nil
        else
            local part = prevPlayer.Character and partFor(prevPlayer.Character) or nil
            if part and isTargetValid(part) then
                Environment.ParsaSilentTarget = part
                Environment.ParsaSilentTargetInfo = { Player = prevPlayer, Part = part }
                return
            end
            Environment.ParsaCurrentTargetPlayer = nil
            Environment.ParsaSilentTarget = nil
            Environment.ParsaSilentTargetInfo = nil
        end
    end
    local best = scanForEnemyTarget()
    if best then
        tlog("TARGET", 2, "->", best.Player.Name)
    else
        tlog("TARGET", 10, "нет доступных врагов (ok=" .. stats.scanOK .. " skipped=" .. stats.scanSkipped .. ")")
    end
    Environment.ParsaSilentTarget = best and best.Part or nil
    Environment.ParsaCurrentTargetPlayer = best and best.Player or nil
    Environment.ParsaSilentTargetInfo = best
end

