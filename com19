local function redirectBulletResult(returns)
    if not Runtime.Alive or Environment.ParsaAutofarmEnabled ~= true then return end
    lastRayRetargetAt = os.clock()
    local result = returns[1]
    local SilentTarget = Environment.ParsaSilentTarget
    if not SilentTarget then
        local found = scanForEnemyTarget()
        if found then
            SilentTarget = found.Part
            Environment.ParsaSilentTarget = found.Part
            Environment.ParsaCurrentTargetPlayer = found.Player
            Environment.ParsaSilentTargetInfo = found
        end
    end
    if not SilentTarget then return end
    if not isTargetValid(SilentTarget) then
        Environment.ParsaSilentTarget = nil
        Environment.ParsaCurrentTargetPlayer = nil
        Environment.ParsaSilentTargetInfo = nil
        return
    end
    local targetPos = SilentTarget.Position
    pcall(function()
        local targetMaterial = "Air"
        pcall(function() targetMaterial = SilentTarget.Material.Name end)
        if type(result) ~= "table" then
            local origin = Camera and Camera.CFrame and Camera.CFrame.Position
            if typeof(origin) ~= "Vector3" then return end
            local delta = targetPos - origin
            local length = delta.Magnitude
            if length < 0.001 then return end
            local unit = delta.Unit
            returns[1] = {
                Origin = origin, Direction = unit, Distance = length,
                Hits = { { Instance = SilentTarget, Position = targetPos, Normal = -unit,
                    Material = targetMaterial, Distance = length, Exit = false } },
            }
            stats.rayRetarget += 1
            return
        end
        local hits = rawget(result, "Hits")
        if type(hits) ~= "table" then
            hits = {}
            rawset(result, "Hits", hits)
        end
        if not SilentTarget.Parent then return end
        local lastIndex = nil
        for index, hit in pairs(hits) do
            if type(hit) == "table" and (lastIndex == nil or index > lastIndex) then
                lastIndex = index
            end
        end
        local finalHit
        if lastIndex then
            finalHit = hits[lastIndex]
        else
            finalHit = {}
            table.insert(hits, finalHit)
        end
        finalHit.Instance = SilentTarget
        finalHit.Position = targetPos
        if finalHit.Exit ~= nil then finalHit.Exit = false end
        if finalHit.Material == nil then finalHit.Material = targetMaterial end
        if finalHit.Normal == nil then finalHit.Normal = Vector3.new(0, 1, 0) end
        local origin = rawget(result, "Origin")
        if typeof(origin) == "Vector3" then
            local delta = targetPos - origin
            local length = delta.Magnitude
            if length > 0.001 then
                result.Distance = length
                local unit = delta.Unit
                result.Direction = unit
                for index, hit in pairs(hits) do
                    if index ~= lastIndex and type(hit) == "table" and typeof(hit.Position) == "Vector3" then
                        local along = (hit.Position - origin):Dot(unit)
                        if along > length then
                            hit.Position = origin + unit * (length * 0.5)
                        end
                    end
                end
            end
        end
        stats.rayRetarget += 1
    end)
end


