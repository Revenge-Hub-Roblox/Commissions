local logThrottle = {}
local function tlog(tag, minInterval, ...)
    local now = os.clock()
    if now - (logThrottle[tag] or 0) < (minInterval or 2) then return end
    logThrottle[tag] = now
    print("[Frozent][" .. tag .. "]", ...)
end

local function bytesToBuffer(bytes)
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end

local function bufferToBytes(buf)
    local bytes = {}
    for i = 0, buffer.len(buf) - 1 do
        bytes[i + 1] = buffer.readu8(buf, i)
    end
    return bytes
end

local function findBytes(hay, from, needle)
    for i = from, #hay - #needle + 1 do
        local ok = true
        for j = 1, #needle do
            if hay[i + j - 1] ~= needle[j] then ok = false break end
        end
        if ok then return i end
    end
    return nil
end

local function isCharacterTargetable(character)
    if not character then return false, "no-char" end
    if character.Parent and character.Parent.Name == "Debris" then return false, "debris" end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if humanoid.Health <= 0 then return false, "dead-hp" end
        if Environment.ParsaSkipInvincible == true and character:GetAttribute("Invincible") then
            return false, "invincible"
        end
        return true
    end
    if character:GetAttribute("Dead") then return false, "dead-attr" end
    if Environment.ParsaSkipInvincible == true and character:GetAttribute("Invincible") then
        return false, "invincible"
    end
    return true
end

local function isTargetValid(targetPart)
    if typeof(targetPart) ~= "Instance" or not targetPart.Parent then return false end
    local character = targetPart:FindFirstAncestorOfClass("Model")
    return isCharacterTargetable(character)
end

local function get_player_team(player)
    if not player then return nil end
    local ok, attr = pcall(player.GetAttribute, player, "Team")
    if ok and attr ~= nil and attr ~= "" then return attr end
    local ok2, team = pcall(function() return player.Team end)
    if ok2 and team ~= nil then return team end
    local character = player.Character
    if character then
        local ok3, cattr = pcall(character.GetAttribute, character, "Team")
        if ok3 and cattr ~= nil and cattr ~= "" then return cattr end
    end
    return nil
end
