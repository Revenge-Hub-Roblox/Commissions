local config = getgenv().GPO_AutoJoin or {}
local ACCOUNTS = config.Accounts or {}
local NOVA_SETTINGS = config.NovaHub or {
    DiscordWebHook = "",
    Optimized = false,
    LockFPS = true,
    FpsCap = 60,
}
local QUEUE_ON_TELEPORT = config.QueueOnTeleport
if QUEUE_ON_TELEPORT == nil then
    QUEUE_ON_TELEPORT = true
end

local LOBBY_PLACE = 1730877806
local MAIN_PLACE  = 3978370137

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

if QUEUE_ON_TELEPORT then
    local SCRIPT_URL = "https://raw.githubusercontent.com/Revenge-Hub-Roblox/Commissions/refs/heads/main/com20"
    queue_on_teleport([[
        getgenv().GPO_AutoJoin = getgenv().GPO_AutoJoin or {}
        loadstring(game:HttpGet("]] .. SCRIPT_URL .. [[") )()
    ]])
end

local VIP_CODE = ACCOUNTS[LP.Name]
if not VIP_CODE then
    return
end

if game.PlaceId == MAIN_PLACE then
    if not LP.Character then
        LP.CharacterAdded:Wait()
    end

    local char = LP.Character
    local hum = char:WaitForChild("Humanoid", 15)
    local hrp = char:WaitForChild("HumanoidRootPart", 15)

    if not hum or not hrp then
        return
    end

    workspace:WaitForChild("PlayerCharacters", 20)
    ReplicatedStorage:WaitForChild("Events", 20)
    ReplicatedStorage:WaitForChild("Modules", 20)

    task.wait(2.5)

    getgenv().NovaHub = NOVA_SETTINGS
    loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/6d1d42f1a622306f0c177c220a85ef47.lua"))()
    return
end

if game.PlaceId ~= LOBBY_PLACE then return end

local function fireChooseType()
    local chooseType = PlayerGui:FindFirstChild("chooseType")
    if not chooseType then return false end

    local remote = chooseType:FindFirstChild("RemoteEvent", true)
    if not remote then return false end

    for i = 1, 6 do
        pcall(function()
            remote:FireServer(true)
        end)
        task.wait(0.18)
    end
    return true
end

local function sendVipCode()
    local reserved = ReplicatedStorage:FindFirstChild("Events") 
                  and ReplicatedStorage.Events:FindFirstChild("reserved")
    if not reserved then return end

    task.spawn(function()
        pcall(function()
            reserved:InvokeServer(VIP_CODE)
        end)
    end)
end

if PlayerGui:FindFirstChild("chooseType") then
    fireChooseType()
else
    sendVipCode()

    local conn
    conn = PlayerGui.ChildAdded:Connect(function(child)
        if child.Name == "chooseType" then
            task.wait(0.7)
            fireChooseType()
            if conn then conn:Disconnect() end
        end
    end)

    task.delay(10, function()
        if conn then
            conn:Disconnect()
            fireChooseType()
        end
    end)
end

task.spawn(function()
    while game.PlaceId == LOBBY_PLACE do
        task.wait(3)
        if game.PlaceId ~= LOBBY_PLACE then break end

        if PlayerGui:FindFirstChild("chooseType") then
            fireChooseType()
        else
            sendVipCode()
        end
    end
end)

TeleportService.TeleportInitFailed:Connect(function(p, result, err)
end)
