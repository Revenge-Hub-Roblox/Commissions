local STABLE_LEAVE = 0.15
local MISS_TIMEOUT = 0.9
local REARM_AFTER_CLICK = 0.30
local REARM_AFTER_MISS = 0.35

local function myNameSet()
    local s = { [Player.Name] = true, [Player.DisplayName] = true }
    if Player.Character then s[Player.Character.Name] = true end
    return s
end

local function updateApproachGate(ball)
    local now = os.clock()

    if gateBall and gateBall ~= ball and not gateBall:IsDescendantOf(Balls) then
        parryState = "idle"
        gateNotUsSince = 0
        smartPrevEta = math.huge
        smartFresh = true
    end
    gateBall = ball

    local names = myNameSet()
    local tgtStr = ball and getBallTargetStr(ball) or nil
    local onUs
    if tgtStr ~= nil then
        onUs = names[tgtStr] == true
    else
        local c = Player.Character
        onUs = c ~= nil and (c:FindFirstChild("Highlight") ~= nil or c:GetAttribute("Targeted") == true)
    end

    if parryState == "locked" then
        if not onUs then
            if gateNotUsSince == 0 then gateNotUsSince = now end
            if (now - gateNotUsSince) >= STABLE_LEAVE then
                parryState = "away"
            end
        else
            gateNotUsSince = 0
            if (now - gateClickedAt) > MISS_TIMEOUT then
                parryState = "idle"
                rearmUntil = now + REARM_AFTER_MISS
                smartFresh = true
            end
        end
    elseif parryState == "away" then
        if onUs then
            parryState = "idle"
            gateNotUsSince = 0
            smartPrevEta = math.huge
            smartFresh = true
        end
    end
end

local function lockApproach(ball)
    parryState = "locked"
    gateBall = ball
    gateClickedAt = os.clock()
    gateNotUsSince = 0
    rearmUntil = gateClickedAt + REARM_AFTER_CLICK
end

local function fireParryNow(reason, ball)
    local now = os.clock()
    if parryState ~= "idle" then return end
    if now < rearmUntil then return end
    if now - LastParry < (CFG.ParryCooldown or 0.055) then return end
    if IsParrying then return end

    IsParrying = true
    LastParry = now
    lockApproach(ball)
    doClick()
    task.delay(CFG.ParryCooldown or 0.055, function()
        IsParrying = false
    end)
end

local function Parry(reason, ball, dist)
    if not CFG.AutoParry then return end
    if parryState ~= "idle" then return end

    if not CFG.SmartDistance and CFG.ParryCheckDistance ~= false then
        local maxDist = CFG.ParryDistance or 60
        if dist and dist > maxDist then
            return
        end
    end

    local react = tonumber(CFG.ParryReactionCD) or 0
    if react <= 0 then
        fireParryNow(reason, ball)
        return
    end

    lockApproach(ball)
    pendingParryToken += 1
    local token = pendingParryToken
    task.delay(react, function()
        if token ~= pendingParryToken then return end
        if not CFG.AutoParry then return end
        local now = os.clock()
        rearmUntil = now + REARM_AFTER_CLICK
        if now - LastParry < (CFG.ParryCooldown or 0.055) then return end
        LastParry = now
        doClick()
    end)
end

local spamBurst = false
local spamOwnsBall = false
local rallyBlockSince = nil
local spamTolerateUntil = 0
local spamPartnerName = nil
local spamBallInstance = nil
local ETA_TOL = 0.03

local function SpamClick(ball)
