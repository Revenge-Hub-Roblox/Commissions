local function updateDuel(ball, root)
    local now = tick()
    local tgtStr = getBallTargetStr(ball)
    local myNames = myNameSet()

    local onMe = tgtStr and myNames[tgtStr] or false

    if tgtStr and not onMe then
        duelPartner = tgtStr
        duelLastSeen = now
        duelActive = true
    elseif onMe then
        duelLastSeen = now
        duelActive = duelPartner ~= nil
    elseif now - duelLastSeen > (CFG.DuelTimeout or 2.5) then
        duelPartner = nil
        duelActive = false
        flightOriginPos = nil
        resetRally()
    end

    if tgtStr ~= lastRallyTarget then
        local prev = lastRallyTarget
        lastRallyTarget = tgtStr

        if onMe then
            local d0 = (ball.Position - root.Position).Magnitude
            if not flightOriginPos or (flightOriginPos - root.Position).Magnitude < d0 then
                flightOriginPos = ball.Position
            end
            if prev and not myNames[prev] and rallyPhase == "sent_away" then
                local awayLongEnough = (now - rallySentAt) >= RALLY_MIN_AWAY
                local gapOk = (now - lastRallyIncAt) >= RALLY_MIN_GAP
                if awayLongEnough and gapOk then
                    rallyCount += 1
                    lastRallyIncAt = now
                end
            end
            rallyPhase = "on_me"
        elseif tgtStr then
            flightOriginPos = nil
            if rallyPhase == "on_me" or (prev and myNames[prev]) then
                local weHit = (os.clock() - LastParry) < 2.0
                if weHit then
                    rallyPhase = "sent_away"
                    rallySentAt = now
                else
                    rallyPhase = "idle"
                end
            end
        end
    elseif onMe then
        if not flightOriginPos then
            flightOriginPos = ball.Position
        end
        if rallyPhase == "idle" then
            rallyPhase = "on_me"
        end
    end

    return duelActive, onMe, rallyCount
end

local function computeThreat(ball, root)
    local ballPos = ball.Position
    local playerPos = root.Position
    local distance = (playerPos - ballPos).Magnitude
    local velocity = getBallVelocity(ball)
    local speed = velocity.Magnitude
    if speed <= 0 then return nil end

    local nowT = tick()
    local dtVel = math.clamp(nowT - lastVelocityTime, 0.001, 0.05)
    lastVelocityTime = nowT
    local accel = (velocity - lastBallVelocity) / dtVel
    local deltaV = (velocity - lastBallVelocity).Magnitude
    lastBallVelocity = velocity

    local dirToPlayer = (playerPos - ballPos)
    if dirToPlayer.Magnitude < 0.01 then return nil end
    dirToPlayer = dirToPlayer.Unit
    local velDir = velocity.Unit
    local dot = dirToPlayer:Dot(velDir)

    if CFG.CurveMode == "Camera" and Camera then
        local camDot = Camera.CFrame.LookVector:Dot(velDir)
        dot = (dot + camDot * 0.35) / 1.35
    elseif CFG.CurveMode == "Adaptive" or CFG.CurveMode == "Linear" then
        if deltaV > 15 then dot = math.max(dot, 0.5) end
    end

    local rootVel = root.AssemblyLinearVelocity or Vector3.zero
    local approachSpeed = (velocity - rootVel):Dot(dirToPlayer)
    local effectiveSpeed = math.max(approachSpeed, speed * 0.72)
    local ttt = distance / math.max(effectiveSpeed, 1)

    local pingSec = getPingSec()
    local horizon = (CFG.PredictionHorizon or 0.45) * (CFG.BallPrediction or 0.08)
    horizon = horizon + math.clamp((speed - 150) * 0.0003, 0, 0.12)
    local transit = (pingSec * 0.5) + (1 / 60) + horizon
    local futurePlayer = playerPos + rootVel * transit
    local curveComp = 0.5 * accel * (transit * transit)
    if curveComp.Magnitude > 15 then curveComp = curveComp.Unit * 15 end
    local futureBall = ballPos + velocity * transit + curveComp
    local futureDist = (futurePlayer - futureBall).Magnitude

    local baseRadius = 16
    local serverRadius = baseRadius + math.clamp(speed * (pingSec * 0.5 + 1 / 60), 0, 22)

    return {
        distance = distance,
        speed = speed,
        approachSpeed = approachSpeed,
        dot = dot,
        ttt = ttt,
        futureDist = futureDist,
        serverRadius = serverRadius,
        deltaV = deltaV,
    }
end

local function ballFullFlightETA(ball, root, curDist)
    if not ball or not root then return math.huge end
    local speed = getBallVelocity(ball).Magnitude
    if speed < 1 then return math.huge end
    local d = curDist or (root.Position - ball.Position).Magnitude
    if flightOriginPos then
        local fd = (flightOriginPos - root.Position).Magnitude
        if fd > d then d = fd end
    end
    return d / speed
end

local function shouldSpamNow()
    if not (CFG.AutoSpam or CFG.Spam) then return false end

    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local ball = getRealBall()
    if not ball then
        spamBurst = false
        return false
    end

    if spamBurst and spamBallInstance and spamBallInstance ~= ball
        and not spamBallInstance:IsDescendantOf(Balls) then
        spamBurst = false
    end
    spamBallInstance = ball

    local _, _, rally = updateDuel(ball, root)

    local now = os.clock()
    local targeted = IsTarget(ball)
    local tgtStr = getBallTargetStr(ball)

    local exchange = targeted
    if not exchange and spamBurst then
        if tgtStr ~= nil and spamPartnerName ~= nil and tgtStr == spamPartnerName then
            exchange = true
        elseif tgtStr == nil and now < spamTolerateUntil then
            exchange = true
        end
    end

    if exchange then
        spamTolerateUntil = now + 0.15
    else
        spamBurst = false
        return false
    end

    local dist = (root.Position - ball.Position).Magnitude

    if CFG.SpamCheckDistance ~= false then
        local cap = (CFG.SpamDistance or 25) + (spamBurst and 3 or 0)
        if dist > cap then
            spamBurst = false
            return false
        end
    end

    if not spamBurst then
        if not targeted then return false end

        if CFG.SpamRequireRally ~= false then
            local rallyOk = (rally or 0) >= (CFG.SpamRallyNeeded or 3)
            if not rallyOk then
                if not rallyBlockSince then rallyBlockSince = now end
                if (now - rallyBlockSince) < (CFG.SpamRallyGrace or 4) then
                    return false
                end
            else
                rallyBlockSince = nil
            end
        else
            rallyBlockSince = nil
        end

        if CFG.SpamETAGate then
            local vel = getBallVelocity(ball)
            local toMe = root.Position - ball.Position
            local approaching = toMe.Magnitude > 0.01 and vel:Dot(toMe.Unit) > 1
            local fullEta = approaching and ballFullFlightETA(ball, root, dist) or math.huge
            if fullEta == math.huge or fullEta ~= fullEta
                or fullEta > (CFG.SpamMaxETA or 0.2) + ETA_TOL then
                return false
            end
        end

        spamPartnerName = duelPartner
        rallyBlockSince = nil
        spamBurst = true
    end

    return true, dist, duelActive, nil, nil, rally, ball
end

RunService.RenderStepped:Connect(function()
    local wantSpam = CFG.AutoSpam or CFG.Spam
    if not wantSpam then
        spamOwnsBall = false
        spamBurst = false
        rallyBlockSince = nil
        spamPartnerName = nil
        return
    end

    local ok, dist, _, _, _, _, ball = shouldSpamNow()
    if not ok then
        spamOwnsBall = false
        return
    end

    spamOwnsBall = true

    local aps = CFG.AutoSpam and (CFG.SpamAPS or 65) or (CFG.SpamSpeed or 50)
    local mode = CFG.AutoSpam and (CFG.SpamBatch or "Extremely Fast") or (CFG.SpamBatch2 or "Fast")

    local apsEff = aps
    if CFG.SpamCheckDistance ~= false then
        local farD = CFG.SpamDistance or 25
        local closeD = 12
        local prox = math.clamp((farD - (dist or farD)) / math.max(farD - closeD, 1), 0, 1)
        apsEff = aps * (0.45 + 0.55 * prox)
    end

    local interval = 1 / math.max(1, apsEff * batchMultiplier(mode))
    interval = math.max(interval, 0.035)

    local now = os.clock()
    if now - LastSpam < interval then return end
    LastSpam = now
    SpamClick(ball)
end)

local VIS_IMAGE = "rbxassetid://134963998806220"
local VIS_MAX_SIZE = 65
local visPart, visDecalTop, visDecalBot
local visSizeSmooth = VIS_MAX_SIZE
local visRot = 0
local visLastSize = VIS_MAX_SIZE

local function ensureVisual()
    if not CFG.VisualRing then
        if visPart then
            visPart.Transparency = 1
            if visDecalTop then visDecalTop.Transparency = 1 end
            if visDecalBot then visDecalBot.Transparency = 1 end
        end
        return
    end
    if not visPart then
        visPart = Instance.new("Part")
        visPart.Name = "Ray_ParryRing"
        visPart.Anchored = true
        visPart.CanCollide = false
        visPart.CanQuery = false
        visPart.CanTouch = false
        visPart.Material = Enum.Material.SmoothPlastic
        visPart.Color = Color3.new(1, 1, 1)
        visPart.Transparency = 1
        visPart.CastShadow = false
        visPart.Size = Vector3.new(VIS_MAX_SIZE, 0.05, VIS_MAX_SIZE)
        visPart.Parent = workspace

        visDecalTop = Instance.new("Decal")
        visDecalTop.Name = "RingTop"
        visDecalTop.Face = Enum.NormalId.Top
        visDecalTop.Texture = VIS_IMAGE
        visDecalTop.Transparency = 0.15
        visDecalTop.Parent = visPart

        visDecalBot = Instance.new("Decal")
        visDecalBot.Name = "RingBot"
        visDecalBot.Face = Enum.NormalId.Bottom
        visDecalBot.Texture = VIS_IMAGE
        visDecalBot.Transparency = 0.15
        visDecalBot.Parent = visPart
    end
end

local function setRingVisible(alpha)
    alpha = math.clamp(alpha or 0.1, 0, 1)
    if visDecalTop then visDecalTop.Transparency = alpha end
    if visDecalBot then visDecalBot.Transparency = alpha end
end

local function updateVisual(root, dist, state, dt, ballInbound)
    ensureVisual()
    if not visPart or not CFG.VisualRing then return end

    dt = dt or (1 / 60)
    local pos = root.Position + Vector3.new(0, -2.55, 0)

    local targetSz
    if ballInbound and dist and dist > 0 then
        targetSz = math.clamp(dist * 0.8, 5, VIS_MAX_SIZE)
    else
        targetSz = VIS_MAX_SIZE
    end

    local lerp = math.clamp(dt * 4, 0, 1)
    visSizeSmooth = visSizeSmooth + (targetSz - visSizeSmooth) * lerp
    local sz = visSizeSmooth
    visPart.Size = Vector3.new(sz, 0.05, sz)

    local sizeDelta = sz - visLastSize
    if math.abs(sizeDelta) > 0.02 then
        local spinSpeed = 1.25
        local mult = 0.6 + math.clamp(math.abs(sizeDelta) * 8, 0, 2)
        if sizeDelta < 0 then
            visRot -= spinSpeed * dt * mult
        else
            visRot += spinSpeed * dt * mult
        end
    end
    visLastSize = sz

    visPart.CFrame = CFrame.new(pos) * CFrame.Angles(0, visRot, 0)

    if state == "parry" then
        setRingVisible(0.02)
    elseif state == "target" then
        setRingVisible(0.08)
    else
        setRingVisible(0.12)
    end
end

RunService.RenderStepped:Connect(function(dt)
    if not CFG.AutoParry and not CFG.VisualRing then return end

    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local ball = getRealBall()
    local threat = ball and computeThreat(ball, root) or nil
    local targeted = false
    local dist = visSizeSmooth / 0.8

    if ball then
        if threat then
            updateDuel(ball, root)
            dist = threat.distance
        else
            dist = (root.Position - ball.Position).Magnitude
        end
        updateApproachGate(ball)
        targeted = IsTarget(ball)
    end

    local state = targeted and "target" or "neutral"

    if CFG.AutoParry and targeted and threat and threat.speed > 3 then
        if parryState ~= "idle" or spamBurst then
            state = "parry"
        elseif not spamOwnsBall then
            local ping = getPingSec()
            local minDot = CFG.SmartMinDot or 0.05
            local approaching = (threat.dot >= minDot) or (threat.approachSpeed > 3)

            local eta
            if threat.approachSpeed > 2 then
                eta = dist / threat.approachSpeed
            elseif threat.speed > 1 then
                eta = dist / threat.speed
            else
                eta = threat.ttt
            end
            if CFG.Prediction ~= false and threat.futureDist < dist and threat.speed > 1 then
                local futEta = threat.futureDist / math.max(threat.approachSpeed, threat.speed * 0.75, 1)
                eta = eta * 0.65 + futEta * 0.35
            end

            if smartLastBall ~= ball then
                smartPrevEta = math.huge
                smartLastBall = ball
                smartFresh = true
            end

            local shouldFire = false
            local reason = ""
            local spike = (threat.deltaV or 0) > 35
            local receding = threat.approachSpeed < -8

            if smartFresh then
                smartPrevEta = eta
                smartFresh = false
            elseif CFG.SmartDistance then
                local baseLead = (CFG.SmartLeadMs or 200) / 1000
                local lead = baseLead + ping * (CFG.SmartPingScale or 0.65) + (1 / 60)
                if threat.speed > 90 then
                    lead = lead + math.clamp((threat.speed - 90) * 0.00055, 0, 0.12)
                end
                if threat.speed > 160 then
                    lead = lead + 0.06
                end
                if CFG.InstantTriggerbot then
                    lead = lead + 0.05
                end
                if spike then
                    lead = lead + 0.08
                end
                local acc = (CFG.Accuracy or 100) / 100
                lead = lead * (0.90 + acc * 0.15)
                lead = math.clamp(lead, 0.08, 0.55)

                local earlySlack = CFG.SmartEarlySlack or 0.05
                local hardMax = CFG.SmartHardMaxStuds or 180
                local emergency = dist <= (CFG.EmergencyRadius or 22)
                    or eta <= math.max(0.09, ping * 0.7)
                    or (spike and dist <= 45)

                local crossed = (smartPrevEta > lead + earlySlack) and (eta <= lead + earlySlack)
                local inBand = eta <= (lead + earlySlack)
                local notAbsurd = (CFG.ParryCheckDistance == false) or (dist <= hardMax)

                if (approaching or emergency) and notAbsurd then
                    if emergency or crossed or (inBand and eta <= smartPrevEta + 0.02) then
                        shouldFire = true
                    end
                end
                smartPrevEta = eta
            else
                local thr = CFG.DistanceToParry or 1.05
                if CFG.Prediction ~= false then
                    thr = thr + (ping * (CFG.PingBasedOffset or 1.2))
                end
                if threat.speed > 100 then
                    thr = thr + math.clamp((threat.speed - 100) * 0.0025, 0, 0.5)
                end
                if CFG.VelocityPrediction and threat.speed > 150 then
                    thr = thr * 1.15
                end
                if CFG.InstantTriggerbot then
                    thr = thr + 0.2
                end
                if spike then
                    thr = thr + 0.25
                end
                local acc = (CFG.Accuracy or 100) / 100
                thr = thr * (0.85 + acc * 0.30)

                local emergency = dist <= (CFG.EmergencyRadius or 22) or spike
                local timeOk = threat.ttt <= thr
                local futureOk = (CFG.Prediction ~= false)
                    and threat.futureDist <= (threat.serverRadius * 1.2)
                local parryDist = CFG.ParryDistance or 60
                local hardCap = CFG.MaxRange or 90
                local inRange = (CFG.ParryCheckDistance == false)
                    or (dist <= math.min(parryDist, hardCap))

                if inRange and (approaching or emergency) and (emergency or timeOk or futureOk) then
                    shouldFire = true
                end
            end

            if shouldFire and receding and not spike and threat.dot < 0.1 then
                shouldFire = false
            end

            if shouldFire then
                state = "parry"
                Parry(reason, ball, CFG.SmartDistance and 0 or dist)
            end
        end
    elseif not targeted then
        smartPrevEta = math.huge
        smartFresh = true
    end

    if CFG.VisualRing then
        updateVisual(root, dist, state, dt, targeted == true)
    else
        if visDecalTop then visDecalTop.Transparency = 1 end
        if visDecalBot then visDecalBot.Transparency = 1 end
    end
end)

