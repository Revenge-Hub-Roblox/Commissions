local function getPingSec()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and tonumber(v) then return tonumber(v) / 1000 end
    local ok2, np = pcall(function() return Player:GetNetworkPing() end)
    if ok2 and np and np > 0 then return np end
    return 0.05
end

local function getBallVelocity(ball)
    local z = ball:FindFirstChild("zoomies")
    if z and (z:IsA("LinearVelocity") or z:IsA("VectorForce")) then
        return z.VectorVelocity
    end
    local v = ball.AssemblyLinearVelocity
    if v.Magnitude > 0 then return v end
    return ball.Velocity or Vector3.zero
end

local function getRealBall()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestD = nil, math.huge
    for _, v in ipairs(Balls:GetChildren()) do
        if not v:IsA("BasePart") then continue end
        local isReal = v:GetAttribute("realBall") == true
        local tgt = v:GetAttribute("target") or v:GetAttribute("Target") or v:GetAttribute("currentTarget")
        if isReal or tgt ~= nil then
            if root then
                local d = (v.Position - root.Position).Magnitude
                if tgt == Player.Name or tgt == Player.DisplayName or (char and tgt == char.Name) then
                    return v
                end
                if d < bestD then bestD, best = d, v end
            else
                return v
            end
        end
    end
    return best
end

local function getNearestEnemy(myPos)
    local alive = workspace:FindFirstChild("Alive")
    local closestD, closestName = math.huge, nil
    local myChar = Player.Character
    if alive then
        for _, c in ipairs(alive:GetChildren()) do
            if c:IsA("Model") and c ~= myChar then
                local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
                if r then
                    local d = (r.Position - myPos).Magnitude
                    if d < closestD then
                        closestD = d
                        closestName = c.Name
                    end
                end
            end
        end
    end
    return closestD, closestName
end

local function batchMultiplier(mode)
    if mode == "Extremely Fast" then return 2.5 end
    if mode == "Fast" then return 1.5 end
    return 1
end

local function spamInterval(aps, mode)
    local rate = math.max(1, (aps or 50) * batchMultiplier(mode))
    return 1 / rate
end

local function VerifyBall(Ball)
    return typeof(Ball) == "Instance"
        and Ball:IsA("BasePart")
        and Ball:IsDescendantOf(Balls)
        and (Ball:GetAttribute("realBall") == true or Ball:GetAttribute("target") ~= nil)
end

local function IsTarget(ball)
    local c = Player.Character
    if not c then return false end
    if not CFG.TargetCheck then return true end
    if c:FindFirstChild("Highlight") ~= nil or c:GetAttribute("Targeted") == true then
        return true
    end
    if ball then
        local t = ball:GetAttribute("target") or ball:GetAttribute("Target")
            or ball:GetAttribute("currentTarget") or ball:GetAttribute("to")
        if t == Player.Name or t == Player.DisplayName or t == c.Name
            or t == Player.UserId or t == tostring(Player.UserId) then
            return true
        end
    end
    return false
end

local function getThreshold()
    local base = CFG.ParryRatio or 10
    local acc = CFG.Accuracy or 100
    if CFG.RandomizeAccuracy then
        acc = math.clamp(acc + math.random(-8, 8), 10, 100)
    end
    return base * (0.55 + (acc / 100) * 0.5)
end

